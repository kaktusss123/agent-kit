# ~/.config/opencode/model-profiles/fm.env
#
# Pure Foundation Models profile.
# Intended for the free FM window: 20:00–10:00.

# C0 — protocol / narrow executor
OC_MODEL_PROTOCOL="cloudru/MiniMaxAI/MiniMax-M3"

# C1 — control / orchestrator
OC_MODEL_CONTROL="cloudru/moonshotai/Kimi-K2.6"

# C2 — repository research
OC_MODEL_RESEARCH="cloudru/MiniMaxAI/MiniMax-M3"

# C3 — requirements / system analysis
OC_MODEL_ANALYSIS="cloudru/deepseek-ai/DeepSeek-V4-Pro"

# C4 — architecture / design / synthesis
OC_MODEL_DESIGN="cloudru/deepseek-ai/DeepSeek-V4-Pro"

# C5 — code / operational execution
OC_MODEL_CODE="cloudru/MiniMaxAI/MiniMax-M3"

# C6 — testing specialist
OC_MODEL_TEST="cloudru/MiniMaxAI/MiniMax-M3"

# C7 — verification / independent review
OC_MODEL_REVIEW="cloudru/deepseek-ai/DeepSeek-V4-Pro"

# C8 — security / adversarial reasoning
OC_MODEL_SECURITY="cloudru/deepseek-ai/DeepSeek-V4-Pro"

HTTP_PROXY=http://ai-proxy.idp.cloud.ru:8080
NO_PROXY=localhost,127.0.0.1
