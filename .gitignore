# macOS metadata
.DS_Store

# Secrets / credentials — never commit real values
.env
.env.*
*.key
*.pem
*.p12
*.pfx

# OMP runtime/generated state (defense-in-depth: the repo never tracks these paths)
# The agent dir is source-named private_agent because ~/.omp/agent is mode 0700.
dot_omp/private_agent/*.db
dot_omp/private_agent/*.db-shm
dot_omp/private_agent/*.db-wal
dot_omp/private_agent/*.lock
dot_omp/private_agent/sessions/
dot_omp/private_agent/memories/
dot_omp/private_agent/terminal-sessions/
dot_omp/private_agent/cache/
dot_omp/private_agent/last-changelog-version
dot_omp/logs/
dot_omp/cache/
dot_omp/plugins/
dot_omp/run/
dot_omp/tasks/
dot_omp/install-id
dot_omp/gpu_cache.json

# Logs
*.log

node_modules/
*.bak.*
