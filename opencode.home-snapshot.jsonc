{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "General",
  "permission": {
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "rtk git push*": "ask"
    },
    "task": {
      "*": "deny"
    }
  },
  "agent": {
    "explore": {
      "disable": true
    },
    "project-init-runner": {
      "model": "opencode-go/deepseek-v4-pro"
    },
    "repo-scout": {
      "hidden": true,
      "model": "opencode-go/deepseek-v4-flash",
      "tools": {
        "kanban_*": false,
        "CodeGraphContext_*": false
      },
      "permission": {
        "task": "deny"
      }
    },
    "feature-triager": {
      "hidden": true,
      "model": "github-copilot/claude-sonnet-4.6",
      "tools": {
        "kanban_*": true,
        "CodeGraphContext_*": false
      },
      "permission": {
        "task": "deny"
      }
    },
    "graph-impact-analyst": {
      "hidden": true,
      "model": "opencode-go/minimax-m2.7",
      "tools": {
        "CodeGraphContext_*": false
      },
      "permission": {
        "task": "deny"
      }
    },
    "design-planner": {
      "hidden": true,
      "model": "github-copilot/claude-sonnet-4.6",
      "tools": {
        "kanban_*": true,
        "CodeGraphContext_*": false
      },
      "permission": {
        "task": "deny"
      }
    },
    "edge-case-harvester": {
      "hidden": true,
      "model": "opencode-go/qwen3.6-plus",
      "tools": {
        "kanban_*": false,
        "CodeGraphContext_*": false
      },
      "permission": {
        "task": "deny"
      }
    },
    "contract-impact-auditor": {
      "hidden": true,
      "model": "github-copilot/claude-sonnet-4.6",
      "tools": {
        "kanban_*": false,
        "CodeGraphContext_*": false
      },
      "permission": {
        "task": "deny"
      }
    },
    "non-functional-prober": {
      "hidden": true,
      "model": "opencode-go/qwen3.6-plus",
      "tools": {
        "kanban_*": false,
        "CodeGraphContext_*": false
      },
      "permission": {
        "task": "deny"
      }
    },
    "traceability-checker": {
      "hidden": true,
      "model": "github-copilot/claude-sonnet-4.6",
      "tools": {
        "kanban_*": false,
        "CodeGraphContext_*": false
      },
      "permission": {
        "task": "deny"
      }
    },
    "implementer": {
      "hidden": true,
      "model": "opencode-go/qwen3.6-plus",
      "tools": {
        "kanban_*": true,
        "CodeGraphContext_*": false
      },
      "permission": {
        "task": "deny"
      }
    },
    "verification-engineer": {
      "hidden": true,
      "model": "opencode-go/deepseek-v4-pro",
      "tools": {
        "kanban_*": true,
        "CodeGraphContext_*": false
      },
      "permission": {
        "task": "deny"
      }
    },
    "reviewer-against-plan": {
      "hidden": true,
      "model": "opencode-go/deepseek-v4-pro",
      "tools": {
        "kanban_*": false,
        "CodeGraphContext_*": false
      },
      "permission": {
        "task": "deny"
      }
    },
    "reviewer-security": {
      "hidden": true,
      "model": "github-copilot/gpt-5.4",
      "tools": {
        "kanban_*": false,
        "CodeGraphContext_*": false
      },
      "permission": {
        "task": "deny"
      }
    },
    "reviewer-deep": {
      "hidden": true,
      "model": "opencode-go/qwen3.6-plus",
      "tools": {
        "kanban_*": false,
        "CodeGraphContext_*": false
      },
      "permission": {
        "task": "deny"
      }
    },
    "reviewer-contracts": {
      "hidden": true,
      "model": "github-copilot/claude-sonnet-4.6",
      "tools": {
        "kanban_*": false,
        "CodeGraphContext_*": false
      },
      "permission": {
        "task": "deny"
      }
    },
    "reviewer-tests": {
      "hidden": true,
      "model": "opencode-go/kimi-k2.6",
      "tools": {
        "kanban_*": false,
        "CodeGraphContext_*": false
      },
      "permission": {
        "task": "deny"
      }
    },
    "reviewer-performance": {
      "hidden": true,
      "model": "opencode-go/kimi-k2.6",
      "tools": {
        "kanban_*": false,
        "CodeGraphContext_*": false
      },
      "permission": {
        "task": "deny"
      }
    },
    "reviewer-complexity": {
      "hidden": true,
      "model": "opencode-go/minimax-m2.7",
      "tools": {
        "kanban_*": false,
        "CodeGraphContext_*": false
      },
      "permission": {
        "task": "deny"
      }
    },
    "committer": {
      "hidden": true,
      "model": "opencode-go/deepseek-v4-flash",
      "tools": {
        "kanban_*": false,
        "CodeGraphContext_*": false
      },
      "permission": {
        "task": "deny"
      }
    },
    "test-planner": {
      "model": "opencode-go/deepseek-v4-pro",
      "permission": {
        "task": "deny"
      }
    },
    "test-reviewer": {
      "model": "opencode-go/kimi-k2.6",
      "permission": {
        "task": "deny"
      }
    },
    "test-writer": {
      "model": "opencode-go/deepseek-v4-flash",
      "permission": {
        "task": "deny"
      }
    },
    "dev-orchestrator": {
      "hidden": true,
      "model": "github-copilot/claude-sonnet-4.6",
      "tools": {
        "kanban_*": true,
        "CodeGraphContext_*": false
      },
      "permission": {
        "task": {
          "*": "deny",
          "repo-scout": "allow",
          "feature-triager": "allow",
          "design-planner": "allow",
          "contract-impact-auditor": "allow",
          "non-functional-prober": "allow",
          "traceability-checker": "allow",
          "implementer": "allow",
          "committer": "allow",
          "verification-engineer": "allow",
          "reviewer-against-plan": "allow",
          "reviewer-security": "allow",
          "reviewer-deep": "allow",
          "reviewer-contracts": "allow",
          "reviewer-tests": "allow",
          "reviewer-performance": "allow",
          "reviewer-complexity": "allow"
        }
      }
    }
  }
}
