{{- $dev := .ompDevRoot | default "" -}}
{{- if $dev }}
{
	"extends": "{{ $dev }}/oh-my-pi/tsconfig.base.json",
	"compilerOptions": {
		"paths": {
			"@oh-my-pi/pi-coding-agent": [
				"{{ $dev }}/oh-my-pi/packages/coding-agent/src/index.ts"
			]
		}
	},
	"include": ["*.ts", "task-workspace/**/*.ts"]
}
{{- else }}
{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true
	},
	"include": ["*.ts", "task-workspace/**/*.ts"]
}
{{- end }}
