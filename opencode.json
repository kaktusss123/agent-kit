{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "General",
  "plugin": ["@slkiser/opencode-quota", "@warp-dot-dev/opencode-warp"],
  "mcp": {
    "atlassian": {
      "type": "local",
      "command": ["uvx", "mcp-atlassian", "--transport", "stdio", "-vv"],
      "environment": {
        "CONFLUENCE_URL": "https://wiki.cloud.ru",
        "CONFLUENCE_PERSONAL_TOKEN": "{env:CONFLUENCE_PERSONAL_TOKEN}",
        "JIRA_URL": "https://jira.cloud.ru",
        "JIRA_PERSONAL_TOKEN": "{env:JIRA_PERSONAL_TOKEN}",
        "CONFLUENCE_SPACES_FILTER": "OCP",
        "JIRA_PROJECTS_FILTER": "EVODP"
      },
      "enabled": true
    },
    "kanban": {
      "type": "local",
      "command": ["kanban-mcp"],
      "environment": {
        "KANBAN_DB_HOST": "localhost",
        "KANBAN_DB_USER": "kanban",
        "KANBAN_DB_PASSWORD": "{env:KANBAN_DB_PASSWORD}",
        "KANBAN_DB_NAME": "kanban"
      }
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "rtk git push*": "ask"
    },
    "task": {
      "*": "deny"
    },
    "skill": {
      "*": "allow",
      "workflow-gates": "deny",
      "kanban-discipline": "deny",
      "codegraph-impact-analysis": "deny",
      "design-brief": "deny",
      "execution-plan": "deny",
      "replan-on-surprise": "deny",
      "verification-gate": "deny",
      "review-against-plan": "deny",
      "commit-readiness": "deny",
      "decision-log": "deny",
      "complexity-review": "deny",
      "implementation": "deny",
      "verification": "deny",
      "review": "deny",
      "orchestration": "deny"
    },
    "external_directory": {
      "~/.config/opencode/*": "allow",
      "/tmp/*": "allow"
    }
  },
  "provider": {
    "cloudru": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CloudRu Foundation Models",
      "options": {
        "baseURL": "https://foundation-models.api.cloud.ru/v1",
        "apiKey": "{env:CLOUDRU_API_KEY}"
      },
      "models": {
        "zai-org/GLM-5.1": {
          "name": "GLM-5.1",
          "limit": {
            "context": 202000,
            "output": 20000
          }
        },
        "moonshotai/Kimi-K2.6": {
          "name": "Kimi-k2.6",
          "limit": {
            "context": 262000,
            "output": 20000
          }
        },
        "MiniMaxAI/MiniMax-M3": {
          "name": "MiniMax-M3",
          "limit": {
            "context": 524000,
            "output": 20000
          }
        },
        "Qwen/Qwen3.5-397B-A17B": {
          "name": "Qwen3.5-397B",
          "limit": {
            "context": 256000,
            "output": 20000
          }
        },
        "Qwen/Qwen3-Coder-Next": {
          "name": "Qwen3-Next",
          "limit": {
            "context": 256000,
            "output": 20000
          }
        },
        "Qwen/Qwen3.6-35B-A3B": {
          "name": "Qwen3.6-35B",
          "limit": {
            "context": 2656000,
            "output": 20000
          }
        },
        "deepseek-ai/DeepSeek-V4-Pro": {
          "name": "DeepSeek-V4-Pro",
          "limit": {
            "context": 1048000,
            "output": 20000
          }
        }
      }
    }
  },
  "agent": {
    "explore": {
      "disable": true
    },
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    },

    "project-init-runner": {
      "model": "opencode-go/deepseek-v4-flash", // альт.: openai/gpt-5.6-luna при сложной генерации AGENTS.md
      "reasoningEffort": "max"
    },

    "repo-scout": {
      "hidden": true,
      "model": "opencode-go/deepseek-v4-flash", // альт.: opencode-go/deepseek-v4-pro для особенно большого/запутанного репозитория
      "tools": {
        "kanban_*": false
      },
      "permission": {
        "task": "deny"
      }
    },

    "feature-triager": {
      "hidden": true,
      "model": "openai/gpt-5.6-luna", // альт.: opencode-go/minimax-m3; эскалация: openai/gpt-5.6-terra
      "tools": {
        "kanban_*": true
      },
      "permission": {
        "task": "deny"
      }
    },

    "graph-impact-analyst": {
      "hidden": true,
      "model": "opencode-go/deepseek-v4-flash", // еще вариант: deepseek-v4-pro; альт.: opencode-go/glm-5.2
      "reasoningEffort": "max",
      "permission": {
        "task": "deny"
      }
    },

    "design-planner": {
      "hidden": true,
      "model": "openai/gpt-5.6-luna", // альт.: openai/gpt-5.6-terra; канарейка: opencode-go/qwen3.8-max
      "tools": {
        "kanban_*": true
      },
      "permission": {
        "task": "deny"
      }
    },

    "edge-case-harvester": {
      "hidden": true,
      // "model": "opencode-go/deepseek-v4-flash", // альт.: opencode-go/minimax-m3 при склонности Flash додумывать поведение
      "model": "cloudru/MiniMaxAI/MiniMax-M3",
      "tools": {
        "kanban_*": false
      },
      "permission": {
        "task": "deny"
      }
    },

    "contract-impact-auditor": {
      "hidden": true,
      "model": "openai/gpt-5.6-luna", // альт.: opencode-go/deepseek-v4-pro; эскалация: openai/gpt-5.6-terra
      "tools": {
        "kanban_*": false
      },
      "permission": {
        "task": "deny"
      }
    },

    "non-functional-prober": {
      "hidden": true,
      "model": "opencode-go/minimax-m3", // альт.: opencode-go/deepseek-v4-pro; эскалация: openai/gpt-5.6-terra
      "tools": {
        "kanban_*": false
      },
      "permission": {
        "task": "deny"
      }
    },

    "traceability-checker": {
      "hidden": true,
      "model": "openai/gpt-5.6-terra", // эконом-вариант: opencode-go/minimax-m3; альт.: opencode-go/kimi-k3
      "tools": {
        "kanban_*": false
      },
      "permission": {
        "task": "deny"
      }
    },

    "implementer": {
      "hidden": true,
      "model": "opencode-go/deepseek-v4-flash", // канарейка: xai/grok-4.5; дешёвые bounded-задачи: deepseek-v4-flash; эскалация: gpt-5.6-terra
      "tools": {
        "kanban_*": true
      },
      "permission": {
        "task": "deny"
      }
    },

    "verification-engineer": {
      "hidden": true,
      "model": "opencode-go/deepseek-v4-flash", // еще вариант: deepseek-v4-pro; альт.: openai/gpt-5.6-luna
      "tools": {
        "kanban_*": true
      },
      "permission": {
        "task": "deny"
      }
    },

    "reviewer-against-plan": {
      "hidden": true,
      "model": "openai/gpt-5.6-terra", // альт.: opencode-go/kimi-k3; эконом-вариант: opencode-go/deepseek-v4-pro
      "tools": {
        "kanban_*": false
      },
      "permission": {
        "task": "deny"
      }
    },

    "reviewer-security": {
      "hidden": true,
      "model": "openai/gpt-5.6-terra", // эскалация: openai/gpt-5.6-sol или opencode-go/kimi-k3
      "reasoningEffort": "high",
      "tools": {
        "kanban_*": false
      },
      "permission": {
        "task": "deny"
      }
    },

    "reviewer-deep": {
      "hidden": true,
      "model": "openai/gpt-5.6-terra", // альт.: opencode-go/kimi-k3; канарейка: opencode-go/qwen3.8-max; эскалация: gpt-5.6-sol
      "reasoningEffort": "high",
      "tools": {
        "kanban_*": false
      },
      "permission": {
        "task": "deny"
      }
    },

    "reviewer-contracts": {
      "hidden": true,
      "model": "opencode-go/deepseek-v4-pro", // дешёвый вариант: deepseek-v4-flash; эскалация: openai/gpt-5.6-terra
      "tools": {
        "kanban_*": false
      },
      "permission": {
        "task": "deny"
      }
    },

    "reviewer-tests": {
      "hidden": true,
      "model": "opencode-go/deepseek-v4-pro", // дешёвый вариант: deepseek-v4-flash; эскалация: openai/gpt-5.6-terra
      "tools": {
        "kanban_*": false
      },
      "permission": {
        "task": "deny"
      }
    },

    "reviewer-performance": {
      "hidden": true,
      "model": "openai/gpt-5.6-terra", // дешёвый вариант: deepseek-v4-flash; эскалация для critical hot path: gpt-5.6-terra
      "tools": {
        "kanban_*": false
      },
      "permission": {
        "task": "deny"
      }
    },

    "reviewer-complexity": {
      "hidden": true,
      "model": "openai/gpt-5.6-luna", // дешёвый вариант: deepseek-v4-flash; эскалация: openai/gpt-5.6-terra
      "tools": {
        "kanban_*": false
      },
      "permission": {
        "task": "deny"
      }
    },

    "committer": {
      "hidden": true,
      "model": "opencode-go/deepseek-v4-flash", // альт.: openai/gpt-5.6-luna, если Flash нарушает процедуру
      "tools": {
        "kanban_*": false
      },
      "permission": {
        "task": "deny"
      }
    },

    "test-planner": {
      "model": "opencode-go/deepseek-v4-pro", // дешёвый вариант: deepseek-v4-flash; альт.: openai/gpt-5.6-luna
      "permission": {
        "task": "deny"
      }
    },

    "test-reviewer": {
      "model": "openai/gpt-5.6-terra", // эконом-вариант: deepseek-v4-pro; эскалация: opencode-go/kimi-k3
      "permission": {
        "task": "deny"
      }
    },

    "test-writer": {
      "model": "opencode-go/kimi-k2.7-code", // канарейка: xai/grok-4.5; дешёвые unit-тесты: deepseek-v4-flash
      "permission": {
        "task": "deny"
      }
    },

    "dev-orchestrator": {
      "model": "openai/gpt-5.6-luna", // альт.: openai/gpt-5.6-luna; эскалация: opencode-go/kimi-k3
      "reasoningEffort": "high",
      "tools": {
        "kanban_*": true
      }
    },

    "FastSpecAnalyst": {
      "model": "openai/gpt-5.6-luna", // альт.: opencode-go/minimax-m3; эскалация: openai/gpt-5.6-terra
      "tools": {
        "kanban_*": true
      }
    },

    "FullSpecAnalyst": {
      "model": "openai/gpt-5.6-terra", // альт.: opencode-go/kimi-k3; эконом-вариант: opencode-go/glm-5.2
      "reasoningEffort": "high",
      "tools": {
        "kanban_*": true
      }
    },

    "General": {
      "model": "opencode-go/deepseek-v4-flash", // альт.: openai/gpt-5.6-luna; сложный код: kimi-k2.7-code или xai/grok-4.5
      "reasoningEffort": "max",
      "tools": {
        "kanban_*": true
      }
    },

    "project-analyst": {
      "hidden": false,
      "model": "openai/gpt-5.6-terra", // эконом-вариант: opencode-go/glm-5.2; массовое чтение: deepseek-v4-flash
      "reasoningEffort": "medium",
      "tools": {
        "kanban_*": false
      }
    },

    "security-surface-mapper": {
      "hidden": true,
      "model": "opencode-go/deepseek-v4-flash", // альт.: opencode-go/deepseek-v4-pro для большого/запутанного репозитория
      "tools": {
        "kanban_*": false
      },
      "permission": {
        "task": "deny"
      }
    },

    "security-scanner": {
      "hidden": true,
      "model": "cloudru/MiniMaxAI/MiniMax-M3", // альт.: opencode-go/kimi-k3; эскалация critical-area: openai/gpt-5.6-terra
      // "model": "openrouter/z-ai/glm-5.2", // альт.: opencode-go/kimi-k3; эскалация critical-area: openai/gpt-5.6-terra
      "tools": {
        "kanban_*": false
      },
      "permission": {
        "task": "deny"
      }
    },

    "security-scan-orchestrator": {
      "model": "openrouter/z-ai/glm-5.2", // альт.: openai/gpt-5.6-luna; эскалация для очень больших репозиториев: opencode-go/kimi-k3
      // "model": "openrouter/z-ai/glm-5.2", // альт.: openai/gpt-5.6-luna; эскалация для очень больших репозиториев: opencode-go/kimi-k3
      "reasoningEffort": "high",
      "tools": {
        "kanban_*": false
      }
    }
  }
}
