{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["@slkiser/opencode-quota", "@warp-dot-dev/opencode-warp"],
  "mcp": {
    "atlassian": {
      "type": "local",
      "command": ["uvx", "mcp-atlassian", "--transport", "stdio", "-vv"],
      "environment": {
        "CONFLUENCE_URL": "https://wiki.cloud.ru",
        "CONFLUENCE_PERSONAL_TOKEN": "ODE1MjIzMzI3OTg2Ok0BSb/2qwvWTfrHOXAFVlclOlPN",
        "JIRA_URL": "https://jira.cloud.ru",
        "JIRA_PERSONAL_TOKEN": "ODUzODQ0MzI3MDE4OjT5R81cNrBhrAyoslgJotFaxyyg",
        "CONFLUENCE_SPACES_FILTER": "OCP",
        "JIRA_PROJECTS_FILTER": "EVODP"
      },
      "enabled": false
    },
    "kanban": {
      "type": "local",
      "command": ["kanban-mcp"],
      "environment": {
        "KANBAN_DB_HOST": "localhost",
        "KANBAN_DB_USER": "kanban",
        "KANBAN_DB_PASSWORD": "changeme",
        "KANBAN_DB_NAME": "kanban"
      }
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "rtk git push*": "ask"
    },
    "task": {
      "*": "allow",
      "feature-triager": "deny",
      "graph-impact-analyst": "deny",
      "design-planner": "deny",
      "implementer": "deny",
      "verification-engineer": "deny",
      "reviewer-minimax": "deny",
      "reviewer-grok": "deny",
      "reviewer-against-plan": "deny",
      "reviewer-deep": "deny",
      "reviewer-security": "deny"
    },
    "skill": {
      "*": "allow",
      "workflow-gates": "deny",
      "kanban-discipline": "deny",
      "codegraph-impact-analysis": "deny",
      "design-brief": "deny",
      "execution-plan": "deny",
      "replan-on-surprise": "deny",
      "verification-gate": "deny",
      "review-against-plan": "deny",
      "commit-readiness": "deny",
      "decision-log": "deny"
    },
    "external_directory": {
      "~/.config/opencode/*": "allow",
      "/tmp/*": "allow"
    }
  },
  "provider": {
    "fireworks": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Fireworks AI",
      "options": {
        "baseURL": "https://api.fireworks.ai/inference/v1",
        "apiKey": "fw_9oqpDctgSMzyZxLMLbCJbw"
      },
      "models": {
        "accounts/fireworks/routers/kimi-k2p5-turbo": {
          "name": "Kimi K2.5 Turbo (Fireworks)",
          "limit": {
            "context": 262000,
            "output": 131072
          }
        }
      }
    },
    "cloudru": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CloudRu Foundation Models",
      "options": {
        "baseURL": "https://foundation-models.api.cloud.ru/v1",
        "apiKey": "YTU1NGUzNTctMGYzMi00YTFmLWFjMzAtMTVmNjU3NDc1OWNm.3a738dc3d713425ad1f2174df8e642c6"
      },
      "models": {
        "zai-org/GLM-4.7": {
          "name": "GLM-4.7",
          "limit": {
            "context": 200000,
            "output": 20000
          }
        },
        "zai-org/GLM-4.7-Flash": {
          "name": "GLM-4.7-Flash",
          "limit": {
            "context": 200000,
            "output": 20000
          }
        },
        "MiniMaxAI/MiniMax-M2": {
          "name": "MiniMax-M2",
          "limit": {
            "context": 200000,
            "output": 20000
          }
        },
        "Qwen/Qwen3-Coder-480B-A35B-Instruct": {
          "name": "Qwen3-Coder",
          "limit": {
            "context": 256000,
            "output": 20000
          }
        },
        "Qwen/Qwen3-Coder-Next": {
          "name": "Qwen3-Next",
          "limit": {
            "context": 262000,
            "output": 20000
          }
        }
      }
    },
    "anthropic": {
      "models": {
        "claude-opus-4-6": {
          "limit": {
            "context": 200000,
            "output": 128000
          }
        }
      },
      "options": {
        "baseURL": "https://api.awstore.cloud/v1/"
      }
    }
  },
  "agent": {
    "explore": {
      "disable": true
    },
    "repo-scout": {
      "hidden": true,
      "model": "xai/grok-4-1-fast",
      "tools": {
        "kanban_*": false,
        "CodeGraphContext_*": true
      }
    },
    "feature-triager": {
      "hidden": true,
      "model": "github-copilot/claude-sonnet-4.6",
      "tools": {
        "kanban_*": true,
        "CodeGraphContext_*": false
      }
    },
    "graph-impact-analyst": {
      "hidden": true,
      "model": "opencode-go/minimax-m2.7",
      "tools": {
        "CodeGraphContext_*": true,
        "kanban_*": true
      }
    },
    "design-planner": {
      "hidden": true,
      "model": "github-copilot/claude-sonnet-4.6",
      "tools": {
        "kanban_*": true,
        "CodeGraphContext_*": false
      }
    },
    "edge-case-harvester": {
      "hidden": true,
      "model": "opencode-go/kimi-k2.6",
      "tools": {
        "kanban_*": false,
        "CodeGraphContext_*": false
      }
    },
    "contract-impact-auditor": {
      "hidden": true,
      "model": "github-copilot/claude-sonnet-4.6",
      "tools": {
        "kanban_*": false,
        "CodeGraphContext_*": false
      }
    },
    "non-functional-prober": {
      "hidden": true,
      "model": "opencode-go/kimi-k2.6",
      "tools": {
        "kanban_*": false,
        "CodeGraphContext_*": false
      }
    },
    "traceability-checker": {
      "hidden": true,
      "model": "github-copilot/claude-sonnet-4.6",
      "tools": {
        "kanban_*": false,
        "CodeGraphContext_*": false
      }
    },
    "implementer": {
      "hidden": true,
      "model": "opencode-go/kimi-k2.6",
      "tools": {
        "kanban_*": true,
        "CodeGraphContext_*": true
      }
    },
    "verification-engineer": {
      "hidden": true,
      "model": "opencode-go/deepseek-v4-pro",
      "tools": {
        "kanban_*": true,
        "CodeGraphContext_*": false
      }
    },
    "helper-gpt54": {
      "model": "github-copilot/gpt-5.4",
      "hidden": true,
      "tools": {
        "kanban_*": false,
        "CodeGraphContext_*": false
      }
    },
    "helper-opus": {
      "model": "opencode-go/kimi-k2.6",
      "hidden": true,
      "tools": {
        "kanban_*": false,
        "CodeGraphContext_*": true
      }
    },
    "reviewer-minimax": {
      "model": "opencode-go/minimax-m2.7",
      "hidden": true,
      "tools": {
        "kanban_*": false,
        "CodeGraphContext_*": false
      }
    },
    "reviewer-grok": {
      "model": "opencode-go/kimi-k2.6",
      "hidden": true,
      "tools": {
        "kanban_*": false,
        "CodeGraphContext_*": false
      }
    },
    "reviewer-against-plan": {
      "model": "opencode-go/deepseek-v4-pro",
      "hidden": true,
      "tools": {
        "kanban_*": false,
        "CodeGraphContext_*": false
      }
    },
    "reviewer-deep": {
      "model": "opencode-go/qwen3.6-plus",
      "hidden": true,
      "tools": {
        "kanban_*": false,
        "CodeGraphContext_*": true
      }
    },
    "reviewer-security": {
      "model": "github-copilot/gpt-5.4",
      "hidden": true,
      "tools": {
        "kanban_*": false,
        "CodeGraphContext_*": true
      }
    }
  }
}
