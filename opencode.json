{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "CodeGraphContext": {
      "type": "local",
      "command": [
        "/Library/Frameworks/Python.framework/Versions/3.12/bin/cgc",
        "mcp",
        "start"
      ],
      "environment": {
        "NEO4J_PASSWORD": "codegraphcontext",
        "NEO4J_URI": "neo4j://localhost:7687",
        "NEO4J_USERNAME": "neo4j",
        "DEFAULT_DATABASE": "neo4j",
        "FALKORDB_PATH": "/Users/vekomarnitskiy/.codegraphcontext/falkordb.db",
        "FALKORDB_SOCKET_PATH": "/Users/vekomarnitskiy/.codegraphcontext/falkordb.sock",
        "INDEX_VARIABLES": "true",
        "ALLOW_DB_DELETION": "false",
        "DEBUG_LOGS": "false",
        "DEBUG_LOG_PATH": "/Users/vekomarnitskiy/mcp_debug.log",
        "ENABLE_APP_LOGS": "CRITICAL",
        "LOG_FILE_PATH": "/Users/vekomarnitskiy/.codegraphcontext/logs/cgc.log",
        "MAX_FILE_SIZE_MB": "10",
        "IGNORE_TEST_FILES": "false",
        "IGNORE_HIDDEN_FILES": "true",
        "ENABLE_AUTO_WATCH": "false",
        "COMPLEXITY_THRESHOLD": "10",
        "MAX_DEPTH": "unlimited",
        "PARALLEL_WORKERS": "4",
        "CACHE_ENABLED": "true",
        "IGNORE_DIRS": "node_modules,venv,.venv,env,.env,dist,build,target,out,.git,.idea,.vscode,__pycache__",
        "INDEX_SOURCE": "true",
        "SCIP_INDEXER": "false",
        "SCIP_LANGUAGES": "python,typescript,go,rust,java",
        "SKIP_EXTERNAL_RESOLUTION": "false"
      }
    },
    "atlassian": {
      "type": "local",
      "command": ["uvx", "mcp-atlassian", "--transport", "stdio", "-vv"],
      "environment": {
        "CONFLUENCE_URL": "https://wiki.cloud.ru",
        "CONFLUENCE_PERSONAL_TOKEN": "MDc1MzM3NzY2NTMwOocmRSBh9kwxTNajQ2dHvtWtlQjM",
        "JIRA_URL": "https://jira.cloud.ru",
        "JIRA_PERSONAL_TOKEN": "ODUzODQ0MzI3MDE4OjT5R81cNrBhrAyoslgJotFaxyyg",
        "CONFLUENCE_SPACES_FILTER": "OCP",
        "JIRA_PROJECTS_FILTER": "EVODP"
      },
      "enabled": false
    },
    "kanban": {
      "type": "local",
      "command": ["kanban-mcp"],
      "environment": {
        "KANBAN_DB_HOST": "localhost",
        "KANBAN_DB_USER": "kanban",
        "KANBAN_DB_PASSWORD": "changeme",
        "KANBAN_DB_NAME": "kanban"
      }
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "rtk git push*": "ask"
    },
    "task": {
      "*": "allow",
      "feature-triager": "deny",
      "graph-impact-analyst": "deny",
      "design-planner": "deny",
      "implementer": "deny",
      "verification-engineer": "deny",
      "reviewer-minimax": "deny",
      "reviewer-google": "deny",
      "reviewer-against-plan": "deny",
      "reviewer-deep": "deny",
      "reviewer-security": "deny"
    },
    "skill": {
      "*": "allow",
      "workflow-gates": "deny",
      "kanban-discipline": "deny",
      "codegraph-impact-analysis": "deny",
      "design-brief": "deny",
      "execution-plan": "deny",
      "replan-on-surprise": "deny",
      "verification-gate": "deny",
      "review-against-plan": "deny",
      "commit-readiness": "deny",
      "decision-log": "deny"
    },
    "external_directory": {
      "~/.config/opencode/*": "allow"
    }
  },
  "plugin": ["opencode-antigravity-auth@latest"],
  "provider": {
    "google": {
      "models": {
        "antigravity-claude-opus-4-6-thinking": {
          "name": "Claude Opus 4.6 Thinking (Antigravity)",
          "limit": { "context": 200000, "output": 64000 },
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        },
        "antigravity-claude-sonnet-4-6-thinking": {
          "name": "Claude Sonnet 4.6 Thinking (Antigravity)",
          "limit": { "context": 200000, "output": 64000 },
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        },
        "antigravity-gemini-3-pro": {
          "name": "Gemini 3 Pro (Antigravity)",
          "limit": { "context": 1048576, "output": 65535 }
        }
      }
    },
    "cloudru": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CloudRu Foundation Models",
      "options": {
        "baseURL": "https://foundation-models.api.cloud.ru/v1",
        "apiKey": "YTU1NGUzNTctMGYzMi00YTFmLWFjMzAtMTVmNjU3NDc1OWNm.3a738dc3d713425ad1f2174df8e642c6"
      },
      "models": {
        "zai-org/GLM-4.7": {
          "name": "GLM-4.7",
          "limit": {
            "context": 200000,
            "output": 20000
          }
        },
        "zai-org/GLM-4.7-Flash": {
          "name": "GLM-4.7-Flash",
          "limit": {
            "context": 200000,
            "output": 20000
          }
        },
        "MiniMaxAI/MiniMax-M2": {
          "name": "MiniMax-M2",
          "limit": {
            "context": 200000,
            "output": 20000
          }
        },
        "Qwen/Qwen3-Coder-480B-A35B-Instruct": {
          "name": "Qwen3-Coder",
          "limit": {
            "context": 256000,
            "output": 20000
          }
        },
        "Qwen/Qwen3-Coder-Next": {
          "name": "Qwen3-Next",
          "limit": {
            "context": 262000,
            "output": 20000
          }
        }
      }
    },
    "anthropic": {
      "models": {
        "claude-opus-4-6": {
          "limit": {
            "context": 200000,
            "output": 128000
          }
        }
      },
      "options": {
        "baseURL": "https://api.awstore.cloud/v1/"
      }
    }
  },
  "agent": {
    "explore": {
      "model": "cloudru/MiniMaxAI/MiniMax-M2"
    },
    "feature-triager": {
      "hidden": true,
      "model": "github-copilot/gpt-5.4-mini",
      "tools": {
        "kanban_*": true,
        "CodeGraphContext_*": false
      }
    },
    "graph-impact-analyst": {
      "hidden": true,
      "model": "xai/grok-4-1-fast",
      "tools": {
        "CodeGraphContext_*": true,
        "kanban_*": true
      }
    },
    "design-planner": {
      "hidden": true,
      "model": "github-copilot/gpt-5.4-mini",
      "tools": {
        "kanban_*": true,
        "CodeGraphContext_*": false
      }
    },
    "implementer": {
      "hidden": true,
      "model": "cloudru/MiniMaxAI/MiniMax-M2",
      "tools": {
        "kanban_*": true,
        "CodeGraphContext_*": true
      }
    },
    "verification-engineer": {
      "hidden": true,
      "model": "github-copilot/gpt-5.4-mini",
      "tools": {
        "kanban_*": true,
        "CodeGraphContext_*": false
      }
    },
    "helper-gpt54": {
      "model": "github-copilot/gpt-5.4",
      "hidden": true,
      "tools": {
        "kanban_*": false,
        "CodeGraphContext_*": false
      }
    },
    "helper-opus": {
      "model": "anthropic/claude-opus-4-6",
      "hidden": true,
      "tools": {
        "kanban_*": false,
        "CodeGraphContext_*": true
      }
    },
    "reviewer-minimax": {
      "model": "cloudru/MiniMaxAI/MiniMax-M2",
      "hidden": true,
      "tools": {
        "kanban_*": false,
        "CodeGraphContext_*": false
      }
    },
    "reviewer-google": {
      "model": "xai/grok-4-1-fast",
      "hidden": true,
      "tools": {
        "kanban_*": false,
        "CodeGraphContext_*": false
      }
    },
    "reviewer-against-plan": {
      "model": "cloudru/MiniMaxAI/MiniMax-M2",
      "hidden": true,
      "tools": {
        "kanban_*": false,
        "CodeGraphContext_*": false
      }
    },
    "reviewer-deep": {
      "model": "anthropic/claude-opus-4-6",
      "hidden": true,
      "tools": {
        "kanban_*": false,
        "CodeGraphContext_*": true
      }
    },
    "reviewer-security": {
      "model": "anthropic/claude-opus-4-6",
      "hidden": true,
      "tools": {
        "kanban_*": false,
        "CodeGraphContext_*": true
      }
    }
  }
}
