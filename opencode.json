      "model": "opencode-go/deepseek-v4-flash",
      "tools": {
        "kanban_*": false,
        "CodeGraphContext_*": false
      },
      "permission": {
        "task": "deny"
      }
    },
    "test_planner": {
      "model": "opencode-go/deepseek-v4-pro",
      "permission": {
        "task": "deny"
      }
    },
    "test_reviewer": {
      "model": "opencode-go/kimi-k2.6",
      "permission": {
        "task": "deny"
      }
    },
    "test_writer": {
      "model": "opencode-go/deepseek-v4-flash",
      "permission": {
        "task": "deny"
      }
    },
    "dev-orchestrator": {
      "hidden": true,
      "model": "cloudru/zai-org/GLM-5.1",
      "tools": {
        "kanban_*": true,
        "CodeGraphContext_*": false
      },
      "permission": {
        "task": {
          "*": "deny",
          "repo-scout": "allow",
          "feature-triager": "allow",
          "design-planner": "allow",
          "contract-impact-auditor": "allow",
          "non-functional-prober": "allow",
          "traceability-checker": "allow",
          "implementer": "allow",
          "committer": "allow",
          "verification-engineer": "allow",
          "reviewer-against-plan": "allow",
          "reviewer-security": "allow",
          "reviewer-deep": "allow",
          "reviewer-contracts": "allow",
          "reviewer-tests": "allow",
          "reviewer-performance": "allow",
          "reviewer-complexity": "allow"
        }
      }
    }
  }
