      "tools": {
        "kanban_*": true,
        "CodeGraphContext_*": false
      },
      "permission": {
        "task": "deny"
      }
    },
    "reviewer-against-plan": {
      "hidden": true,
      "model": "opencode-go/deepseek-v4-pro",
      "tools": {
        "kanban_*": false,
        "CodeGraphContext_*": false
      },
      "permission": {
        "task": "deny"
      }
    },
    "reviewer-security": {
      "hidden": true,
      "model": "cloudru/zai-org/GLM-5.1",
      "tools": {
        "kanban_*": false,
        "CodeGraphContext_*": false
      },
      "permission": {
        "task": "deny"
      }
    },
    "reviewer-deep": {
      "hidden": true,
      "model": "opencode-go/qwen3.6-plus",
      "tools": {
        "kanban_*": false,
        "CodeGraphContext_*": false
      },
      "permission": {
        "task": "deny"
      }
    },
    "reviewer-contracts": {
      "hidden": true,
      "model": "cloudru/zai-org/GLM-5.1",
      "tools": {
        "kanban_*": false,
        "CodeGraphContext_*": false
      },
      "permission": {
        "task": "deny"
      }
    },
    "reviewer-tests": {
      "hidden": true,
      "model": "opencode-go/kimi-k2.6",
      "tools": {
        "kanban_*": false,
        "CodeGraphContext_*": false
      },
      "permission": {
        "task": "deny"
      }
    },
    "reviewer-performance": {
      "hidden": true,
      "model": "cloudru/moonshotai/Kimi-K2.6",
      "tools": {
        "kanban_*": false,
