{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["@slkiser/opencode-quota", "@warp-dot-dev/opencode-warp"],
  "mcp": {
    "atlassian": {
      "type": "local",
      "command": ["uvx", "mcp-atlassian", "--transport", "stdio", "-vv"],
      "environment": {
        "CONFLUENCE_URL": "https://wiki.cloud.ru",
        "CONFLUENCE_PERSONAL_TOKEN": "ODE1MjIzMzI3OTg2Ok0BSb/2qwvWTfrHOXAFVlclOlPN",
        "JIRA_URL": "https://jira.cloud.ru",
        "JIRA_PERSONAL_TOKEN": "MDI1NjUzMjQ2NzY5On8hdyfbnE2Z1eynrYQfG9LCsNhB",
        "CONFLUENCE_SPACES_FILTER": "OCP",
        "JIRA_PROJECTS_FILTER": "EVODP"
      },
      "enabled": false
    },
    "kanban": {
      "type": "local",
      "command": ["kanban-mcp"],
      "environment": {
        "KANBAN_DB_HOST": "localhost",
        "KANBAN_DB_USER": "kanban",
        "KANBAN_DB_PASSWORD": "changeme",
        "KANBAN_DB_NAME": "kanban"
      }
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "rtk git push*": "ask"
    },
    "task": {
      "*": "deny",
      "feature-triager": "deny",
      "graph-impact-analyst": "deny",
      "design-planner": "deny",
      "committer": "deny",
      "implementer": "deny",
      "verification-engineer": "deny",
      "reviewer-against-plan": "deny",
      "reviewer-deep": "deny",
      "reviewer-security": "deny",
      "reviewer-contracts": "deny",
      "reviewer-tests": "deny",
      "reviewer-performance": "deny",
      "reviewer-complexity": "deny"
    },
    "skill": {
      "*": "allow",
      "workflow-gates": "deny",
      "kanban-discipline": "deny",
      "codegraph-impact-analysis": "deny",
      "design-brief": "deny",
      "execution-plan": "deny",
      "replan-on-surprise": "deny",
      "verification-gate": "deny",
      "review-against-plan": "deny",
      "commit-readiness": "deny",
      "decision-log": "deny",
      "complexity-review": "deny",
      "implementation": "deny",
      "verification": "deny",
      "review": "deny",
      "orchestration": "deny"
    },
    "external_directory": {
      "~/.config/opencode/*": "allow",
      "/tmp/*": "allow"
    }
  },
  "provider": {
    "fireworks": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Fireworks AI",
      "options": {
        "baseURL": "https://api.fireworks.ai/inference/v1",
        "apiKey": "fw_9oqpDctgSMzyZxLMLbCJbw"
      },
      "models": {
        "accounts/fireworks/routers/kimi-k2p5-turbo": {
          "name": "Kimi K2.5 Turbo (Fireworks)",
          "limit": {
            "context": 262000,
            "output": 131072
          }
        }
      }
    },
    "cloudru": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CloudRu Foundation Models",
      "options": {
        "baseURL": "https://foundation-models.api.cloud.ru/v1",
        "apiKey": "ZDg3NmQxNDgtMWViNC00ZGYwLTgzMzgtYWQ5YTcxZWIzNTVh.41f81c3d8939f42d12fd2a46c3aa4379"
      },
      "models": {
        "zai-org/GLM-5.1": {
          "name": "GLM-5.1",
          "limit": {
            "context": 196000,
            "output": 20000
          }
        },
        "moonshotai/Kimi-K2.6": {
          "name": "Kimi-k2.6",
          "limit": {
            "context": 256000,
            "output": 20000
          }
        },
        "MiniMaxAI/MiniMax-M2.5": {
          "name": "MiniMax-M2",
          "limit": {
            "context": 192000,
            "output": 20000
          }
        },
        "Qwen/Qwen3.5-397B-A17B": {
          "name": "Qwen3.5-397B",
          "limit": {
            "context": 256000,
            "output": 20000
          }
        },
        "Qwen/Qwen3-Coder-Next": {
          "name": "Qwen3-Next",
          "limit": {
            "context": 256000,
            "output": 20000
          }
        },
        "Qwen/Qwen3.6-35B-A3B": {
          "name": "Qwen3.6-35B",
          "limit": {
            "context": 2656000,
            "output": 20000
          }
        },
        "deepseek-ai/DeepSeek-V4-Pro": {
          "name": "DeepSeek-V4-Pro",
          "limit": {
            "context": 1000000,
            "output": 20000
          }
        }
      }
    }
  },
  // office
  "agent": {
    "explore": {
      "disable": true
    },
    "project-init-runner": {
      "model": "cloudru/deepseek-ai/DeepSeek-V4-Pro"
    },
    "repo-scout": {
      "hidden": true,
      "model": "opencode-go/deepseek-v4-flash",
      "tools": {
        "kanban_*": false,
        "CodeGraphContext_*": false
      },
      "permission": {
        "task": "deny"
      }
    },
    "feature-triager": {
      "hidden": true,
      "model": "cloudru/moonshotai/Kimi-K2.6",
      "tools": {
        "kanban_*": true,
        "CodeGraphContext_*": false
      },
      "permission": {
        "task": "deny"
      }
    },
    "graph-impact-analyst": {
      "hidden": true,
      "model": "opencode-go/minimax-m2.7",
      "tools": {
        "CodeGraphContext_*": false
      },
      "permission": {
        "task": "deny"
      }
    },
    "design-planner": {
      "hidden": true,
      "model": "cloudru/moonshotai/Kimi-K2.6",
