{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "General",
  "plugin": ["@slkiser/opencode-quota", "@warp-dot-dev/opencode-warp"],
  "mcp": {
    "atlassian": {
      "type": "local",
      "command": ["uvx", "mcp-atlassian", "--transport", "stdio", "-vv"],
      "environment": {
        "CONFLUENCE_URL": "https://wiki.cloud.ru",
        "CONFLUENCE_PERSONAL_TOKEN": "{env:CONFLUENCE_PERSONAL_TOKEN}",
        "JIRA_URL": "https://jira.cloud.ru",
        "JIRA_PERSONAL_TOKEN": "{env:JIRA_PERSONAL_TOKEN}",
        "CONFLUENCE_SPACES_FILTER": "OCP",
        "JIRA_PROJECTS_FILTER": "EVODP"
      },
      "enabled": true
    },
    "kanban": {
      "type": "local",
      "command": ["kanban-mcp"],
      "environment": {
        "KANBAN_DB_HOST": "localhost",
        "KANBAN_DB_USER": "kanban",
        "KANBAN_DB_PASSWORD": "{env:KANBAN_DB_PASSWORD}",
        "KANBAN_DB_NAME": "kanban"
      }
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "rtk git push*": "ask"
    },
    "task": {
      "*": "deny"
    },
    "skill": {
      "*": "allow",
      "python-codestyle": "allow",
      "python-knowledge": "allow",
      "workflow-gates": "deny",
      "kanban-discipline": "deny",
      "codegraph-impact-analysis": "deny",
      "design-brief": "deny",
      "execution-plan": "deny",
      "replan-on-surprise": "deny",
      "verification-gate": "deny",
      "review-against-plan": "deny",
      "commit-readiness": "deny",
      "decision-log": "deny",
      "complexity-review": "deny",
      "implementation": "deny",
      "verification": "deny",
      "review": "deny",
      "orchestration": "deny"
    },
    "external_directory": {
      "~/.config/opencode/*": "allow",
      "/tmp/*": "allow"
    }
  },
  "provider": {
    "cloudru": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CloudRu Foundation Models",
      "options": {
        "baseURL": "https://foundation-models.api.cloud.ru/v1",
        "apiKey": "{env:CLOUDRU_API_KEY}"
      },
      "models": {
        "zai-org/GLM-5.1": {
          "name": "GLM-5.1",
          "limit": {
            "context": 202000,
            "output": 20000
          }
        },
        "moonshotai/Kimi-K2.6": {
          "name": "Kimi-k2.6",
          "limit": {
            "context": 262000,
            "output": 20000
          }
        },
        "MiniMaxAI/MiniMax-M3": {
          "name": "MiniMax-M3",
          "limit": {
            "context": 524000,
            "output": 20000
          }
        },
        "Qwen/Qwen3.5-397B-A17B": {
          "name": "Qwen3.5-397B",
          "limit": {
            "context": 256000,
            "output": 20000
          }
        },
        "Qwen/Qwen3-Coder-Next": {
          "name": "Qwen3-Next",
          "limit": {
            "context": 256000,
            "output": 20000
          }
        },
        "Qwen/Qwen3.6-35B-A3B": {
          "name": "Qwen3.6-35B",
          "limit": {
            "context": 2656000,
            "output": 20000
          }
        },
        "deepseek-ai/DeepSeek-V4-Pro": {
          "name": "DeepSeek-V4-Pro",
          "limit": {
            "context": 1048000,
            "output": 20000
          }
        }
      }
    }
  },
  "agent": {
    "explore": {
      "disable": true
    },
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    },

    "project-init-runner": {
      "model": "{env:OC_MODEL_PROTOCOL}"
    },

    "repo-scout": {
      "hidden": true,
      "model": "{env:OC_MODEL_RESEARCH}",
      "tools": {
        "kanban_*": false
      },
      "permission": {
        "task": "deny"
      }
    },

    "feature-triager": {
      "hidden": true,
      "model": "{env:OC_MODEL_ANALYSIS}",
      "tools": {
        "kanban_*": true
      },
      "permission": {
        "task": "deny"
      }
    },

    "graph-impact-analyst": {
      "hidden": true,
      "model": "{env:OC_MODEL_RESEARCH}",
      "permission": {
        "task": "deny"
      }
    },

    "design-planner": {
      "hidden": true,
      "model": "{env:OC_MODEL_DESIGN}",
      "tools": {
        "kanban_*": true
      },
      "permission": {
        "task": "deny"
      }
    },

    "edge-case-harvester": {
      "hidden": true,
      "model": "{env:OC_MODEL_ANALYSIS}",
      "tools": {
        "kanban_*": false
      },
      "permission": {
        "task": "deny"
