#!/usr/bin/env bash
# Refreshes the active runtime after a successful pull.

set -u

PERSONAL_DIR="$(cd "$(dirname "$0")/.." && pwd)"
FRAMEWORK_DIR="${OPENCODE_FRAMEWORK_DIR:-$HOME/projects/core/docs/OpenCode}"

if [ -x "$FRAMEWORK_DIR/scripts/install.sh" ]; then
  INSTALL_CMD=("$FRAMEWORK_DIR/scripts/install.sh")
  BUNDLE_DIR="$FRAMEWORK_DIR"
else
  INSTALL_CMD=("$PERSONAL_DIR/scripts/install-vendored-bundle.sh")
  BUNDLE_DIR="$PERSONAL_DIR/vendor/opencode-bundle"
fi

STATE_FILE="$PERSONAL_DIR/.opencode-handoff-state.json"
if [ ! -f "$STATE_FILE" ]; then
  exit 0
fi

if ! python3 -c '
import json, os, sys
try:
    state = json.load(open(sys.argv[1]))
    bundle = os.path.realpath(sys.argv[2])
    targets = state.get("managed_symlinks", {}).values()
    installed = any(os.path.commonpath([os.path.realpath(target), bundle]) == bundle for target in targets)
except (OSError, ValueError, json.JSONDecodeError):
    installed = False
sys.exit(0 if installed else 1)
' "$STATE_FILE" "$BUNDLE_DIR"; then
  exit 0
fi

if ! "${INSTALL_CMD[@]}"; then
  echo "Warning: OpenCode links were not refreshed. Run the installer manually." >&2
fi

exit 0
