#!/usr/bin/env bash
#
# agent-kit — install shared and per-runtime agent assets into their native
# runtime locations.
#
# The repository layout IS the desired state:
#   shared/skills/*            — skills shared by every supporting runtime
#   runtimes/<rt>/skills/*     — runtime-specific skills
#   runtimes/<rt>/extensions/* — runtime extensions (dirs and files)
#   ... (see README.md for the full convention)
#
# Entities are symlinked, never copied. Ownership is tracked in a local
# state file ($XDG_STATE_HOME/agent-kit/links.tsv, one
# "<runtime>\t<dest-rel>\t<source>" per line). Only paths recorded there —
# and only while the target still points where agent-kit last linked it —
# are ever replaced or removed. Everything else in a runtime directory
# (your own skills, other installers' links, plain files) is left alone and
# reported as a conflict if the repository wants its place.
#
# Re-running install from another checkout or worktree repoints the managed
# links to that checkout — the previous target is never modified.
#
# Usage:
#   agent-kit install [runtime...]   # default: every runtime found in PATH
#   agent-kit uninstall [runtime...] # default: every runtime with owned links
#   agent-kit status
#
# Runtime root overrides (optional):
#   PI_AGENT_DIR          (default ~/.pi/agent)
#   OMP_AGENT_DIR         (default ~/.omp/agent)
#   OPENCODE_CONFIG_DIR   (default ~/.config/opencode)

set -euo pipefail

# --- locate the repository --------------------------------------------------

# Resolve symlinks first: agent-kit is typically on PATH as a symlink into a
# checkout (e.g. ~/.local/bin/agent-kit). SCRIPT_DIR must be the REAL script
# directory — otherwise repository detection falls back outside the repo, the
# desired-entity set resolves empty, and a mere `install` run would prune
# every managed link.
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd -P)"
REPO="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || printf '%s/..' "$SCRIPT_DIR")"
REPO="$(cd "$REPO" && pwd -P)"
# Tests (and sandboxes) can point the installer at a different checkout:
REPO="${AGENT_KIT_ROOT:-$REPO}"
[ -d "$REPO" ] || die "repository root not found: $REPO"

STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
STATE_FILE="$STATE_HOME/agent-kit/links.tsv"

TAB="$(printf '\t')"
RUNTIMES="pi omp opencode"

# --- tiny helpers ------------------------------------------------------------

msg()  { printf '%s\n' "$*"; }
warn() { printf 'warning: %s\n' "$*" >&2; }
die()  { printf 'error: %s\n' "$*" >&2; exit 2; }

is_runtime() {
	case "$1" in
	pi|omp|opencode) return 0 ;;
	*) return 1 ;;
	esac
}

runtime_root() {
	case "$1" in
	pi)       printf '%s' "${PI_AGENT_DIR:-$HOME/.pi/agent}" ;;
	omp)      printf '%s' "${OMP_AGENT_DIR:-$HOME/.omp/agent}" ;;
	opencode) printf '%s' "${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}" ;;
	esac
}

have_binary() { command -v "$1" >/dev/null 2>&1; }

line_count() { # stdin -> number of non-empty lines
	local n=0 line
	while IFS= read -r line || [ -n "$line" ]; do
		[ -n "$line" ] && n=$((n + 1))
	done
	printf '%s' "$n"
}

# --- entity enumeration -------------------------------------------------------
#
# Every adapter prints its desired entities as lines:
#   <dest-path-relative-to-runtime-root>TAB<absolute-source-path>
# The installer core knows nothing about individual runtimes beyond these
# lines; the adapters know nothing about linking or state.

emit_file() { # <source-abs> <dest-rel>
	[ -f "$1" ] || return 0
	printf '%s%s%s\n' "$2" "$TAB" "$1"
}

emit_top() { # <source-dir> <dest-rel-dir> — 1:1 by entry name (files and dirs)
	local src="$1" rel="$2" e
	[ -d "$src" ] || return 0
	for e in "$src"/*; do
		[ -e "$e" ] || continue
		printf '%s/%s%s%s\n' "$rel" "$(basename "$e")" "$TAB" "$e"
	done
}

emit_tree() { # <source-dir> <dest-rel-dir> — every file, recursive, same layout
	local src="$1" rel="$2" f
	[ -d "$src" ] || return 0
	while IFS= read -r f; do
		printf '%s/%s%s%s\n' "$rel" "${f#"$src"/}" "$TAB" "$f"
	done < <(find "$src" -type f | sort)
}

entities_for() { # <runtime> — desired entities of one runtime
	case "$1" in
	pi)
		emit_top "$REPO/shared/skills"           "skills"
		emit_top "$REPO/runtimes/pi/skills"      "skills"
		emit_top "$REPO/runtimes/pi/extensions"  "extensions"
		emit_top "$REPO/runtimes/pi/prompts"     "prompts"
		;;
	omp)
		emit_top "$REPO/shared/skills"            "skills"
		emit_top "$REPO/runtimes/omp/skills"      "skills"
		emit_top "$REPO/runtimes/omp/extensions"  "extensions"
		emit_top "$REPO/runtimes/omp/prompts"     "prompts"
		emit_top "$REPO/runtimes/omp/managed-skills" "managed-skills"
		emit_top "$REPO/runtimes/omp/docs"        "docs"
		emit_file "$REPO/runtimes/omp/RULES.md"       "RULES.md"
		emit_file "$REPO/runtimes/omp/PERSONALITY.md" "PERSONALITY.md"
		emit_file "$REPO/runtimes/omp/WATCHDOG.md"    "WATCHDOG.md"
		;;
	opencode)
		emit_top "$REPO/shared/skills"            "skills"
		emit_top "$REPO/runtimes/opencode/skills" "skills"
		emit_top "$REPO/runtimes/opencode/tool"   "tool"
		emit_top "$REPO/runtimes/opencode/commands" "commands"
		emit_top "$REPO/runtimes/opencode/plugins"  "plugins"
		emit_tree "$REPO/runtimes/opencode/agents" "agents"
		emit_file "$REPO/runtimes/opencode/AGENTS.md" "AGENTS.md"
		;;
	esac
}

# The same destination wanted twice (e.g. one skill in both shared/ and
# runtimes/<rt>/) is a configuration error — no implicit override semantics.
check_duplicates() { # stdin: desired entities
	local dup line
	dup="$(cut -f1 | sort | uniq -d)"
	if [ -n "$dup" ]; then
		printf 'error: duplicate desired destinations (same item in shared and runtime?)\n' >&2
		while IFS= read -r line; do
			printf '  %s\n' "$line" >&2
		done <<EOF
$dup
EOF
		return 1
	fi
}

validate_entity() { # <dest-rel> <source-abs>
	case "$1" in
	""|/*|*..*) die "unsafe destination path: '$1'" ;;
	esac
	case "$2" in
	"$REPO"/*) : ;;
	*) die "source outside the repository: '$2'" ;;
	esac
}

# --- state handling ------------------------------------------------------------
#
# State is one line per managed link:  <runtime>TAB<dest-rel>TAB<source>
# Lines that do not parse are dropped with a warning: corrupt state can
# never widen what agent-kit is allowed to touch, only shrink it.

state_load() { # <runtime> — sets STATE_KEEP (other runtimes), STATE_OWN (this one)
	local runtime="$1" line r rest
	STATE_KEEP=""
	STATE_OWN=""
	[ -f "$STATE_FILE" ] || return 0
	while IFS= read -r line || [ -n "$line" ]; do
		[ -n "$line" ] || continue
		r="${line%%"$TAB"*}"
		rest="${line#*"$TAB"}"
		if [ "$rest" = "$line" ] || [ "$r" = "$line" ]; then
			warn "ignoring corrupt state line: $line"
			continue
		fi
		if [ "$r" = "$runtime" ]; then
			STATE_OWN="${STATE_OWN}${rest}"$'\n'
		elif is_runtime "$r"; then
			STATE_KEEP="${STATE_KEEP}${line}"$'\n'
		else
			warn "ignoring state line for unknown runtime: $line"
		fi
	done < "$STATE_FILE"
}

state_save() { # <runtime> on stdin: own entries as <dest-rel>TAB<source>
	local runtime="$1" line
	mkdir -p "$(dirname "$STATE_FILE")"
	{
		printf '%s' "$STATE_KEEP"
		while IFS= read -r line || [ -n "$line" ]; do
			[ -n "$line" ] || continue
			printf '%s%s%s\n' "$runtime" "$TAB" "$line"
		done
	} > "$STATE_FILE.tmp"
	mv "$STATE_FILE.tmp" "$STATE_FILE"
}

state_mentions() { # <dest-rel> — exact-field check: does this runtime's state contain the path?
	printf '%s' "$STATE_OWN" | awk -F '\t' -v r="$1" '$1 == r { found = 1 } END { exit !found }'
}

state_source_for() { # <dest-rel> — recorded source for a path (empty if absent)
	printf '%s' "$STATE_OWN" | awk -F '\t' -v r="$1" '$1 == r { print $2; exit }'
}

# --- install (reconcile) --------------------------------------------------------
#
# Link/delete decisions are made only for paths in the ownership state, and
# only while the target is still exactly the symlink agent-kit created
# (readlink equals the recorded source). Everything else is reported, never
# touched.

reconcile_runtime() { # <runtime> — exits 1 if conflicts were found
	local runtime="$1" root
	root="$(runtime_root "$runtime")"

	local desired conflicts=0 created=0 updated=0 kept=0 pruned=0
	desired="$(entities_for "$runtime")"
	if ! printf '%s\n' "$desired" | check_duplicates; then
		msg "  $runtime: configuration error — nothing installed"
		return 1
	fi

	state_load "$runtime"

	if [ "$(printf '%s\n' "$desired" | line_count)" -eq 0 ] && \
	   [ "$(printf '%s' "$STATE_OWN" | line_count)" -eq 0 ]; then
		msg "  $runtime: nothing to install (no entities in this repository)"
		return 0
	fi

	# Pass 1 — resolve state entries the repository no longer wants.
	local still_desired="" line rel src dst
	while IFS= read -r line || [ -n "$line" ]; do
		[ -n "$line" ] || continue
		rel="${line%%"$TAB"*}"
		src="${line#*"$TAB"}"
		dst="$root/$rel"
		if printf '%s\n' "$desired" | awk -F '\t' -v r="$rel" '$1 == r { found = 1 } END { exit !found }'; then
			still_desired="${still_desired}${rel}${TAB}${src}"$'\n'   # handled in pass 2
			continue
		fi
		if [ ! -e "$dst" ] && [ ! -L "$dst" ]; then
			msg "  prune   $rel (target already gone)"
		elif [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]; then
			rm "$dst"
			msg "  remove  $rel (no longer in agent-kit)"
		else
			msg "  forget  $rel (no longer in agent-kit; target was changed externally, left untouched)"
		fi
		pruned=$((pruned + 1))
	done <<EOF
$STATE_OWN
EOF

	# Pass 2 — ensure every desired entity.
	local final_state="" cur recorded
	while IFS= read -r line || [ -n "$line" ]; do
		[ -n "$line" ] || continue
		rel="${line%%"$TAB"*}"
		src="${line#*"$TAB"}"
		validate_entity "$rel" "$src"
		dst="$root/$rel"
		mkdir -p "$(dirname "$dst")"
		if [ -L "$dst" ]; then
			cur="$(readlink "$dst")"
			recorded="$(printf '%s\n' "$still_desired" | awk -F '\t' -v r="$rel" '$1 == r { print $2; exit }')"
			if [ "$cur" = "$src" ]; then
				final_state="${final_state}${rel}${TAB}${src}"$'\n'
				kept=$((kept + 1))
			elif [ -n "$recorded" ] && [ "$cur" = "$recorded" ]; then
				# Link still points where agent-kit last put it (recorded in
				# state) — safe to repoint at this checkout.
				ln -sfn "$src" "$dst"
				final_state="${final_state}${rel}${TAB}${src}"$'\n'
				msg "  relink  $rel"
				msg "            was: $cur"
				updated=$((updated + 1))
			else
				conflicts=$((conflicts + 1))
				msg "  conflict $rel"
				msg "    wants:  $src"
				msg "    target: $dst -> $cur"
				if state_mentions "$rel"; then
					msg "    this link was redirected manually; agent-kit released ownership and left it untouched."
				else
					msg "    unmanaged symlink; agent-kit never replaces links it does not own."
				fi
			fi
		elif [ -e "$dst" ]; then
			conflicts=$((conflicts + 1))
			msg "  conflict $rel"
			msg "    wants:  $src"
			msg "    target: $dst exists and is not a symlink"
			if state_mentions "$rel"; then
				msg "    a managed link was replaced by a real file; agent-kit released ownership and left it untouched."
			else
				msg "    agent-kit never overwrites real files or directories."
			fi
		else
			ln -s "$src" "$dst"
			final_state="${final_state}${rel}${TAB}${src}"$'\n'
			msg "  link    $rel"
			created=$((created + 1))
		fi
	done <<EOF
$desired
EOF

	printf '%s\n' "$final_state" | state_save "$runtime"

	msg "  $runtime: $((created + updated + kept)) entity(ies) — $created created, $updated relinked, $kept up to date; $pruned pruned"
	if [ "$conflicts" -gt 0 ]; then
		msg "  $runtime: $conflicts conflict(s) — conflicting targets were not touched"
		return 1
	fi
}

# --- uninstall ------------------------------------------------------------------

uninstall_runtime() { # <runtime>
	local runtime="$1" root removed=0 released=0 line rel src dst
	root="$(runtime_root "$runtime")"
	state_load "$runtime"

	while IFS= read -r line || [ -n "$line" ]; do
		[ -n "$line" ] || continue
		rel="${line%%"$TAB"*}"
		src="${line#*"$TAB"}"
		dst="$root/$rel"
		if [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]; then
			rm "$dst"
			msg "  removed  $rel"
			removed=$((removed + 1))
		elif [ ! -e "$dst" ] && [ ! -L "$dst" ]; then
			msg "  gone     $rel"
		else
			msg "  released $rel (target changed externally; left untouched)"
			released=$((released + 1))
		fi
	done <<EOF
$STATE_OWN
EOF

	printf '\n' | state_save "$runtime"

	if [ "$removed" -eq 0 ] && [ "$released" -eq 0 ]; then
		msg "  $runtime: no owned links"
	else
		msg "  $runtime: removed $removed link(s), released $released (ownership forgotten)"
	fi
}

# --- status ----------------------------------------------------------------------

status_runtime() { # <runtime>
	local runtime="$1" root bin_path desired total
	root="$(runtime_root "$runtime")"
	if have_binary "$runtime"; then
		bin_path="$(command -v "$runtime")"
	else
		bin_path="not found"
	fi
	desired="$(entities_for "$runtime")"
	total="$(printf '%s\n' "$desired" | line_count)"

	state_load "$runtime"
	local managed uptodate=0 stale=0 missing=0 foreign=0 line rel src dst cur
	managed="$(printf '%s' "$STATE_OWN" | line_count)"
	while IFS= read -r line || [ -n "$line" ]; do
		[ -n "$line" ] || continue
		rel="${line%%"$TAB"*}"
		src="${line#*"$TAB"}"
		dst="$root/$rel"
		if [ -L "$dst" ]; then
			cur="$(readlink "$dst")"
			if printf '%s\n' "$desired" | awk -F '\t' -v r="$rel" -v s="$cur" '$1 == r && $2 == s { found = 1 } END { exit !found }'; then
				uptodate=$((uptodate + 1))
			elif [ "$cur" = "$src" ]; then
				stale=$((stale + 1))
			else
				foreign=$((foreign + 1))
			fi
		else
			missing=$((missing + 1))
		fi
	done <<EOF
$STATE_OWN
EOF

	printf '  %s\n' "$runtime (binary: $bin_path)"
	printf '    repository wants %s entity(ies)\n' "$total"
	printf '    state: %s managed — %s up to date, %s relink needed, %s missing, %s redirected\n' \
		"$managed" "$uptodate" "$stale" "$missing" "$foreign"
}

# --- commands ----------------------------------------------------------------------

detect_runtimes() {
	local r
	for r in $RUNTIMES; do
		have_binary "$r" && printf '%s\n' "$r"
	done
	return 0
}

runtimes_in_state() {
	[ -f "$STATE_FILE" ] || return 0
	local r
	while IFS= read -r r; do
		is_runtime "$r" && printf '%s\n' "$r"
	done < <(cut -f1 "$STATE_FILE" | sort -u)
	return 0
}

cmd_install() {
	local selected="" r rc=0 detected skipped found

	if [ $# -eq 0 ]; then
		detected="$(detect_runtimes)"
		if [ -z "$detected" ]; then
			die "no supported runtime found in PATH (looked for: $RUNTIMES); install one or pass an explicit name, e.g. 'agent-kit install pi'"
		fi
		for r in $detected; do
			selected="$selected $r"
		done
		found="$detected"
		skipped=""
		for r in $RUNTIMES; do
			case "$found" in
			*"$r"*) : ;;
			*) skipped="${skipped}  $r$TAB binary not found"$'\n' ;;
			esac
		done
		msg "Detected:"
		for r in $found; do
			msg "  $r"
		done
		if [ -n "$skipped" ]; then
			msg ""
			msg "Skipped:"
			printf '%s' "$skipped"
		fi
		msg ""
	else
		for r in "$@"; do
			is_runtime "$r" || die "unknown runtime '$r' (supported: $RUNTIMES)"
			selected="$selected $r"
		done
	fi

	msg "Installing:"
	for r in $selected; do
		if ! have_binary "$r"; then
			warn "$r: binary not found in PATH — installing anyway (explicit request)"
		fi
		reconcile_runtime "$r" || rc=1
	done
	return "$rc"
}

cmd_uninstall() {
	local r rc=0
	if [ $# -eq 0 ]; then
		set -- $(runtimes_in_state)
		if [ $# -eq 0 ]; then
			msg "agent-kit owns no links"
			return 0
		fi
	fi
	for r in "$@"; do
		is_runtime "$r" || die "unknown runtime '$r' (supported: $RUNTIMES)"
		uninstall_runtime "$r" || rc=1
	done
	return "$rc"
}

cmd_status() {
	local r
	for r in $RUNTIMES; do
		status_runtime "$r"
	done
	msg ""
	msg "state file: $STATE_FILE"
}

usage() {
	cat <<'EOF'
agent-kit — install shared and per-runtime agent assets

Usage:
  agent-kit install [runtime...]    install (default: every runtime found in PATH)
  agent-kit uninstall [runtime...]  remove owned links (default: all runtimes)
  agent-kit status                  show link state per runtime
  agent-kit help                    this text

Runtimes: pi, omp, opencode. Installing an explicit runtime works even if
its binary is not in PATH (warning only). Install is a reconcile operation:
re-running it from another checkout or worktree repoints agent-kit's own
links to that checkout. Links and files agent-kit does not own are never
touched.
EOF
}

case "${1:-}" in
install)   shift; cmd_install "$@" ;;
uninstall) shift; cmd_uninstall "$@" ;;
status)    shift; cmd_status "$@" ;;
-h|--help|help) usage ;;
"")        usage ;;
*)         die "unknown command '$1' (try: install, uninstall, status, help)" ;;
esac
