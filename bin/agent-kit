#!/usr/bin/env node
//
// agent-kit — install the agent framework assets into the selected hosts.
//
// One install links the same checkout into each selected host (ADR-0007, host
// selection: ADR-0009):
//
//   pi (root $PI_AGENT_DIR, default ~/.pi/agent):
//     skills/*        -> skills/*
//     extensions/*    -> extensions/*
//     prompts/*       -> prompts/*
//     rules/AGENTS.md -> AGENTS.md
//
//   claude-code (root $CLAUDE_CONFIG_DIR, default ~/.claude):
//     skills/*             -> skills/*
//     rules/AGENTS.md      -> rules/agent-kit.md
//     rules/claude-code.md -> rules/agent-kit-claude-code.md
//     claude-code/plugin   -> skills/agent-kit  (skills-directory plugin:
//                                                hooks + bin/, loaded in place)
//     claude-code/commands/* -> commands/*      (/spec, /dev entrypoints)
//     claude-code/agents/*   -> agents/*        (Explore, repo-owner subagents)
//
// The repository layout IS the desired state: no manifests, no lists. Entities
// are symlinked, never copied; see lib/entities.mjs for the mapping and
// lib/reconcile.mjs for the ownership rules. Ownership is tracked per host in
// $XDG_STATE_HOME/agent-kit/links*.tsv, the host selection in the sibling
// `hosts` file, and the bootstrapped ~/.local/bin/agent-kit in `command.tsv`.
//
// Required runtime: Node.js >= 24, no package installation and no network.
// `task` still runs extensions/task-workspace/cli.ts through Bun, and `snapshot`
// is still the Bash writer in bin/agent-kit-snapshot until it is ported; both
// are delegated, never reimplemented here.
//
// This file is the dispatcher only: argument validation, exit-code policy and
// the command table. Everything it calls owns one thing.

import { dirname, join } from "node:path";
import { FatalError, runChild, statOrNull, writeStderr, writeStdout } from "./lib/io.mjs";
import { resolvePaths, validateHosts } from "./lib/paths.mjs";
import { installHosts, statusAll, uninstallHosts } from "./lib/reconcile.mjs";
import { migrateLegacyState } from "./lib/legacy-state.mjs";
import { update } from "./lib/update.mjs";
import { task } from "./lib/task.mjs";

function usage() {
	writeStdout(`agent-kit — install the personal agent framework into Pi and Claude Code

Usage:
  agent-kit install [<host>...]
                        link the checkout into the selected hosts; named
                        hosts are added to the selection (default: all):
                        pi          -> ~/.pi/agent (skills, extensions,
                                       prompts, AGENTS.md)
                        claude-code -> ~/.claude (skills, rules/, the
                                       agent-kit plugin, commands/, agents/)
  agent-kit update      git pull --ff-only in this checkout, then reconcile
                        the selected hosts
  agent-kit snapshot <releases-dir>
                        write an immutable, content-addressed snapshot of
                        HEAD (extensions + node_modules) to
                        <releases-dir>/<sha>/ and point <releases-dir>/current
                        at it; keeps current plus the 5 newest snapshots.
                        Operations on one releases dir are serialized with
                        an exclusive lock (flock on <releases-dir>/.lock
                        where flock(1) exists, otherwise an atomic mkdir of
                        <releases-dir>/.lock.d; bounded wait of 60 s,
                        AGENT_KIT_SNAPSHOT_LOCK_TIMEOUT overrides it, and a
                        mkdir lock older than AGENT_KIT_SNAPSHOT_LOCK_STALE
                        seconds is taken over;
                        AGENT_KIT_SNAPSHOT_LOCK=auto|flock|mkdir forces
                        the mechanism, auto being the default). An old
                        snapshot that cannot be removed is a warning, not a
                        failure.
  agent-kit uninstall [<host>...]
                        remove owned links of the named hosts and drop them
                        from the selection; without hosts: every host, and
                        the selection is cleared
  agent-kit status      show the host selection, link state and launcher
                        ownership
  agent-kit task <op>   task-workspace CLI (status, ensure, remove-lane,
                        teardown, commit, hook); JSON in, JSON out
  agent-kit help        this text

The repository layout is the desired state; entities are symlinked, never
copied. Install is a reconcile operation: re-running it from another
checkout or worktree repoints agent-kit's own links to that checkout.
Links and files agent-kit does not own are never touched, and neither
are the links of hosts that are not selected. The selection lives in
$XDG_STATE_HOME/agent-kit/hosts. State left by
older multi-runtime versions of agent-kit is migrated once: links
agent-kit provably owns are cleaned up or repointed, anything else is
released.
`);
}

// snapshot keeps its current Bash writer for now; the delegation is explicit so
// that porting it later deletes exactly this function and its file.
async function snapshot(paths, args) {
	const bridge = join(dirname(paths.entry), "agent-kit-snapshot");
	if (statOrNull(bridge)?.isFile() !== true) {
		throw new FatalError(`snapshot implementation missing: ${bridge}`);
	}
	return runChild(bridge, args, {
		env: { ...process.env, AGENT_KIT_ROOT: paths.repo },
	});
}

async function main(argv) {
	const paths = resolvePaths(argv.entry);
	const args = argv.args;
	const command = args[0] ?? "";
	const rest = args.slice(1);

	switch (command) {
		case "install":
			validateHosts(rest);
			migrateLegacyState(paths.linkStateFile("pi"), paths.home);
			return installHosts(paths, rest);
		case "uninstall":
			validateHosts(rest);
			migrateLegacyState(paths.linkStateFile("pi"), paths.home);
			uninstallHosts(paths, rest);
			return 0;
		case "update":
			if (rest.length > 0) throw new FatalError("update takes no arguments (see: agent-kit help)");
			return await update(paths.repo);
		case "snapshot":
			return await snapshot(paths, rest);
		case "status":
			if (rest.length > 0) throw new FatalError("status takes no arguments (see: agent-kit help)");
			statusAll(paths);
			return 0;
		case "task":
			return await task(paths.repo, rest);
		case "-h":
		case "--help":
		case "help":
		case "":
			usage();
			return 0;
		default:
			throw new FatalError(
				`unknown command '${command}' (try: install, uninstall, update, snapshot, status, task, help)`,
			);
	}
}

try {
	const status = await main({ entry: process.argv[1], args: process.argv.slice(2) });
	if (status !== 0) process.exitCode = status;
} catch (err) {
	if (err instanceof FatalError) {
		writeStderr(`error: ${err.message}\n`);
		process.exitCode = err.exitCode;
	} else {
		writeStderr(`error: ${err?.message ?? String(err)}\n`);
		process.exitCode = 1;
	}
}
