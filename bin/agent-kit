#!/usr/bin/env bash
#
# agent-kit — install the agent framework assets into the selected hosts.
#
# One install links the same checkout into each selected host (ADR-0007,
# host selection: ADR-0009):
#
#   pi (root $PI_AGENT_DIR, default ~/.pi/agent):
#     skills/*        -> skills/*
#     extensions/*    -> extensions/*
#     prompts/*       -> prompts/*        (only if the category exists)
#     rules/AGENTS.md -> AGENTS.md        (only if the file exists)
#
#   claude-code (root $CLAUDE_CONFIG_DIR, default ~/.claude):
#     skills/*             -> skills/*
#     rules/AGENTS.md      -> rules/agent-kit.md
#     rules/claude-code.md -> rules/agent-kit-claude-code.md
#     claude-code/plugin   -> skills/agent-kit  (skills-directory plugin:
#                                                hooks + bin/, loaded in place)
#     claude-code/commands/* -> commands/*      (/spec, /dev entrypoints)
#
# A skill limits its hosts with `metadata.hosts` in its SKILL.md frontmatter
# (comma-separated host names); without it the skill goes to every host.
#
# The repository layout IS the desired state: no manifests, no lists.
# Entities are symlinked, never copied.
#
# Ownership is tracked per host in a local state file
# ($XDG_STATE_HOME/agent-kit/links.tsv for pi, links-<host>.tsv for other
# hosts; one "<dest-rel>\t<source>" per line, relative to the host root).
# Only paths recorded there — and only while the target still points where
# agent-kit last linked it — are ever replaced or removed.
# Everything else in the host directories (your own skills, other tools'
# links, plain files) is left alone and reported as a conflict if the
# repository wants its place.
#
# Host selection: not every machine needs every host. The selected hosts are
# recorded in $XDG_STATE_HOME/agent-kit/hosts (one host name per line).
# Without that file (installs made before host selection existed) the
# selection is derived from the link state: every host whose state file
# holds at least one valid row. "install <host>..." adds hosts to the
# selection; a bare install or update reconciles exactly the selected
# hosts. An empty selection — a fresh machine, or one whose hosts were all
# removed with "uninstall <host>..." — means "nothing chosen yet", so a bare
# install then installs every host. Links of unselected hosts are never
# touched by install or update.
#
# Re-running install from another checkout or worktree repoints the managed
# links to that checkout — the previous target is never modified.
#
# Legacy state: earlier multi-runtime versions of agent-kit recorded
# "<runtime>\t<dest-rel>\t<source>" rows. The installer migrates own rows
# to the current format once and, for rows of retired runtimes, removes
# links whose target is still provably the one agent-kit created (same
# ownership proof as everything else). Anything manually redirected is
# released, never deleted. Retired runtimes are never install targets.
#
# Usage:
#   agent-kit install [<host>...]    reconcile the selected hosts; named
#                                    hosts are added to the selection
#   agent-kit update                 git pull --ff-only, then a bare install
#   agent-kit uninstall [<host>...]  remove the named hosts' links and drop
#                                    them from the selection; without hosts
#                                    remove every host and the selection
#   agent-kit status
#
# Hosts: pi, claude-code.
# Root overrides: PI_AGENT_DIR (default ~/.pi/agent),
# CLAUDE_CONFIG_DIR (default ~/.claude).
# AGENT_KIT_ROOT roots the installer at a different checkout (tests).

set -euo pipefail

# --- locate the repository --------------------------------------------------

# Resolve this script through symlinks: the bootstrapped ~/.local/bin/agent-kit
# must find the checkout it points at, not the directory holding the symlink.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
	_link="$(readlink "$SELF")"
	case "$_link" in
	/*) SELF="$_link" ;;
	*)  SELF="$(dirname "$SELF")/$_link" ;;
	esac
done
SCRIPT="$(cd "$(dirname "$SELF")" && pwd -P)/$(basename "$SELF")"
SCRIPT_DIR="$(dirname "$SCRIPT")"
REPO="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || printf '%s/..' "$SCRIPT_DIR")"
REPO="$(cd "$REPO" && pwd -P)"
# Tests (and sandboxes) can point the installer at a different checkout:
REPO="${AGENT_KIT_ROOT:-$REPO}"

STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
PI_STATE_FILE="$STATE_HOME/agent-kit/links.tsv"
STATE_FILE="$PI_STATE_FILE"
CMD_STATE_FILE="$STATE_HOME/agent-kit/command.tsv"
SELECTION_FILE="$STATE_HOME/agent-kit/hosts"

TAB="$(printf '\t')"
PI_ROOT="${PI_AGENT_DIR:-$HOME/.pi/agent}"
CLAUDE_ROOT="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
HOSTS="pi claude-code"

use_host() { # <host> — selects HOST, ROOT and STATE_FILE for the shared operations
	HOST="$1"
	case "$HOST" in
	pi)          ROOT="$PI_ROOT";     STATE_FILE="$PI_STATE_FILE" ;;
	claude-code) ROOT="$CLAUDE_ROOT"; STATE_FILE="$STATE_HOME/agent-kit/links-claude-code.tsv" ;;
	*)           die "unknown host: $HOST" ;;
	esac
}

msg()  { printf '%s\n' "$*"; }
warn() { printf 'warning: %s\n' "$*" >&2; }
die()  { printf 'error: %s\n' "$*" >&2; exit 2; }

[ -d "$REPO" ] || die "repository root not found: $REPO"

LAUNCHER="$HOME/.local/bin/agent-kit"

is_safe_rel() { # <path> — usable as a destination relative to a host root
	case "$1" in
	""|/*|*..*) return 1 ;;
	esac
	return 0
}

is_safe_source() { # <path> — absolute, no traversal
	case "$1" in
	/*) case "$1" in *..*) return 1 ;; esac
		return 0 ;;
	esac
	return 1
}

line_count() { # stdin -> number of non-empty lines
	local n=0 line
	while IFS= read -r line || [ -n "$line" ]; do
		[ -n "$line" ] && n=$((n + 1))
	done
	printf '%s' "$n"
}

# --- entity enumeration -------------------------------------------------------
#
# The desired state per host: every top-level entry of each category, linked
# 1:1 by entry name, plus single canonical files. Categories absent from the
# repository simply contribute nothing.

skill_hosts() { # <skill-dir> — metadata.hosts from the SKILL.md frontmatter, or empty
	[ -f "$1/SKILL.md" ] || return 0
	awk '
		NR == 1 { if ($0 != "---") exit; next }
		$0 == "---" { exit }
		/^metadata:[ \t]*$/ { meta = 1; next }
		meta && /^[^ \t]/ { meta = 0 }
		meta && /^[ \t]+hosts:/ { sub(/^[ \t]+hosts:[ \t]*/, ""); gsub(/[]["'"'"' \t]/, ""); print; exit }
	' "$1/SKILL.md"
}

emit_skills() { # skills/* that target $HOST
	local e hosts
	[ -d "$REPO/skills" ] || return 0
	for e in "$REPO/skills"/*; do
		[ -e "$e" ] || continue
		hosts="$(skill_hosts "$e")"
		case ",$hosts," in
		,,|*",$HOST,"*) printf 'skills/%s%s%s\n' "$(basename "$e")" "$TAB" "$e" ;;
		esac
	done
}

emit_category() { # <repo-dir> <dest-rel-dir>
	local src="$1" rel="$2" e
	[ -d "$src" ] || return 0
	for e in "$src"/*; do
		[ -e "$e" ] || continue
		printf '%s/%s%s%s\n' "$rel" "$(basename "$e")" "$TAB" "$e"
	done
}

emit_file() { # <repo-file> <dest-rel> — one canonical file
	local f="$1" rel="$2"
	[ -f "$f" ] || return 0
	printf '%s%s%s\n' "$rel" "$TAB" "$f"
}

entities() {
	emit_skills
	case "$HOST" in
	pi)
		emit_category "$REPO/extensions" "extensions"
		emit_category "$REPO/prompts"    "prompts"
		emit_file     "$REPO/rules/AGENTS.md" "AGENTS.md"
		;;
	claude-code)
		emit_file     "$REPO/rules/AGENTS.md"      "rules/agent-kit.md"
		emit_file     "$REPO/rules/claude-code.md" "rules/agent-kit-claude-code.md"
		emit_dir      "$REPO/claude-code/plugin"   "skills/agent-kit"
		emit_category "$REPO/claude-code/commands" "commands"
		;;
	esac
}

emit_dir() { # <repo-dir> <dest-rel> — one canonical directory
	local d="$1" rel="$2"
	[ -d "$d" ] || return 0
	printf '%s%s%s\n' "$rel" "$TAB" "$d"
}

validate_entity() { # <dest-rel> <source-abs>
	is_safe_rel "$1" || die "unsafe destination path: '$1'"
	case "$2" in
	"$REPO"/*) : ;;
	*) die "source outside the repository: '$2'" ;;
	esac
}

# --- legacy state migration -----------------------------------------------------
#
# One-time conversion from the multi-runtime state format. Old lines look
# like "<runtime>\t<dest-rel>\t<source>". Own-runtime rows become
# current-format rows; rows of retired runtimes are cleaned up under their
# native roots with the same ownership proof used everywhere else (remove
# only if the target is still exactly the recorded source), then dropped
# from state. After the first mutating command the state file contains
# only current-format lines.
#
# All knowledge of retired runtimes is confined to the three functions in
# this section; nothing outside them may branch on a runtime name.

legacy_roots() { # native roots of retired runtimes (historical constants; cleanup targets only, never install targets)
	LEGACY_ROOT_A="$HOME/.omp/agent"
	LEGACY_ROOT_B="$HOME/.config/opencode"
}

legacy_retire() { # <root> <legacy-runtime-name> <dest-rel> <source>
	local dst
	dst="$1/$3"
	if [ ! -e "$dst" ] && [ ! -L "$dst" ]; then
		msg "  legacy $2: $3 (target already gone)"
	elif [ -L "$dst" ] && [ "$(readlink "$dst")" = "$4" ]; then
		rm "$dst"
		msg "  legacy $2: removed $3 (no longer an agent-kit target)"
	else
		msg "  legacy $2: released $3 (target changed externally, left untouched)"
	fi
}

migrate_legacy_state() { # rewrite STATE_FILE to the current format, cleaning up legacy links
	[ -f "$STATE_FILE" ] || return 0
	local out="" changed=0 line r rest rel src
	legacy_roots
	while IFS= read -r line || [ -n "$line" ]; do
		[ -n "$line" ] || continue
		case "$line" in
		*"$TAB"*"$TAB"*)
			# Three or more fields: the legacy multi-runtime format.
			r="${line%%"$TAB"*}"
			rest="${line#*"$TAB"}"
			rel="${rest%%"$TAB"*}"
			src="${rest#*"$TAB"}"
			case "$src" in *"$TAB"*) warn "ignoring invalid state line: $line"; changed=1; continue ;; esac
			if ! is_safe_rel "$rel" || ! is_safe_source "$src"; then
				warn "ignoring invalid state line: $line"
				changed=1
				continue
			fi
			case "$r" in
			pi)
				# Own runtime: keep ownership under the current format.
				out="${out}${rel}${TAB}${src}"$'\n'
				changed=1
				;;
			omp)
				legacy_retire "$LEGACY_ROOT_A" "$r" "$rel" "$src"
				changed=1
				;;
			opencode)
				legacy_retire "$LEGACY_ROOT_B" "$r" "$rel" "$src"
				changed=1
				;;
			*)
				warn "ignoring state line for unknown legacy runtime: $line"
				changed=1
				;;
			esac
			;;
		*)
			# Current format: keep as-is (validated where it is used).
			out="${out}${line}"$'\n'
			;;
		esac
	done < "$STATE_FILE"
	if [ "$changed" -eq 1 ]; then
		mkdir -p "$(dirname "$STATE_FILE")"
		printf '%s' "$out" > "$STATE_FILE.tmp"
		mv "$STATE_FILE.tmp" "$STATE_FILE"
	fi
}

# --- state handling ------------------------------------------------------------
#
# State is one line per managed link:  <dest-rel>TAB<source>
# Every line is fully validated BEFORE it can influence any filesystem
# decision: exactly two fields, a safe relative destination (no traversal,
# stays under the Pi root) and an absolute source. Invalid lines are
# dropped with a warning: corrupt state can never widen what agent-kit is
# allowed to touch, only shrink it.

state_load() { # sets STATE_OWN (this install's owned entries)
	local line rel src
	STATE_OWN=""
	[ -f "$STATE_FILE" ] || return 0
	while IFS= read -r line || [ -n "$line" ]; do
		[ -n "$line" ] || continue
		rel="${line%%"$TAB"*}"
		src="${line#*"$TAB"}"
		if [ "$src" = "$line" ] || case "$src" in *"$TAB"*) true ;; *) false ;; esac || \
		   ! is_safe_rel "$rel" || ! is_safe_source "$src"; then
			warn "ignoring invalid state line: $line"
			continue
		fi
		STATE_OWN="${STATE_OWN}${rel}${TAB}${src}"$'\n'
	done < "$STATE_FILE"
}

state_save() { # stdin: own entries as <dest-rel>TAB<source>
	mkdir -p "$(dirname "$STATE_FILE")"
	cat > "$STATE_FILE.tmp"
	mv "$STATE_FILE.tmp" "$STATE_FILE"
}

state_mentions() { # <dest-rel> — exact-field check: does the state contain the path?
	printf '%s' "$STATE_OWN" | awk -F '\t' -v r="$1" '$1 == r { found = 1 } END { exit !found }'
}

# --- host selection ----------------------------------------------------------------
#
# Host lists are space-separated and always kept in $HOSTS order, so the
# selection file content does not depend on argument order or duplicates.

is_host() { # <name> — exactly one known host name
	local h
	for h in $HOSTS; do
		[ "$1" = "$h" ] && return 0
	done
	return 1
}

validate_hosts() { # <name>... — dies (exit 2) on the first unknown name, before any change
	local h
	for h in "$@"; do
		is_host "$h" || die "unknown host: '$h' (hosts: $HOSTS)"
	done
}

host_list() { # <name>... — the known hosts among the arguments, in $HOSTS order
	local h out=""
	for h in $HOSTS; do
		case " $* " in
		*" $h "*) out="$out $h" ;;
		esac
	done
	printf '%s' "${out# }"
}

host_has_links() { # <host> — its link state file holds at least one valid row
	use_host "$1"
	state_load 2>/dev/null
	[ "$(printf '%s' "$STATE_OWN" | line_count)" -gt 0 ]
}

selection_load() { # sets SELECTION (host list) and SELECTION_SOURCE (recorded|derived)
	local line h derived=""
	SELECTION=""
	if [ -f "$SELECTION_FILE" ]; then
		SELECTION_SOURCE=recorded
		while IFS= read -r line || [ -n "$line" ]; do
			[ -n "$line" ] || continue
			if is_host "$line"; then
				SELECTION="$SELECTION $line"
			else
				warn "ignoring invalid host selection line: $line"
			fi
		done < "$SELECTION_FILE"
	else
		# Installs made before host selection existed: every host that already
		# owns links stays selected.
		SELECTION_SOURCE=derived
		for h in $HOSTS; do
			host_has_links "$h" && derived="$derived $h"
		done
		SELECTION="$derived"
	fi
	# shellcheck disable=SC2086 # word splitting of the host list is intended
	SELECTION="$(host_list $SELECTION)"
}

selection_save() { # <host>... — record exactly these hosts (none: an empty selection)
	local h
	mkdir -p "$(dirname "$SELECTION_FILE")"
	: > "$SELECTION_FILE.tmp"
	for h in "$@"; do
		printf '%s\n' "$h" >> "$SELECTION_FILE.tmp"
	done
	mv "$SELECTION_FILE.tmp" "$SELECTION_FILE"
}

# --- install (reconcile) --------------------------------------------------------
#
# Link/delete decisions are made only for paths in the ownership state, and
# only while the target is still exactly the symlink agent-kit created
# (readlink equals the recorded source). Everything else is reported, never
# touched.

reconcile() { # exits 1 if conflicts were found
	local desired conflicts=0 created=0 updated=0 kept=0 pruned=0
	desired="$(entities)"

	state_load

	if [ "$(printf '%s\n' "$desired" | line_count)" -eq 0 ] && \
	   [ "$(printf '%s' "$STATE_OWN" | line_count)" -eq 0 ]; then
		msg "  nothing to install (no installable content in this repository)"
		return 0
	fi

	# Pass 1 — resolve state entries the repository no longer wants.
	local still_desired="" line rel src dst
	while IFS= read -r line || [ -n "$line" ]; do
		[ -n "$line" ] || continue
		rel="${line%%"$TAB"*}"
		src="${line#*"$TAB"}"
		dst="$ROOT/$rel"
		if printf '%s\n' "$desired" | awk -F '\t' -v r="$rel" '$1 == r { found = 1 } END { exit !found }'; then
			still_desired="${still_desired}${rel}${TAB}${src}"$'\n'   # handled in pass 2
			continue
		fi
		if [ ! -e "$dst" ] && [ ! -L "$dst" ]; then
			msg "  prune   $rel (target already gone)"
		elif [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]; then
			rm "$dst"
			msg "  remove  $rel (no longer in agent-kit)"
		else
			msg "  forget  $rel (no longer in agent-kit; target was changed externally, left untouched)"
		fi
		pruned=$((pruned + 1))
	done <<EOF
$STATE_OWN
EOF

	# Pass 2 — ensure every desired entity.
	local final_state="" cur recorded
	while IFS= read -r line || [ -n "$line" ]; do
		[ -n "$line" ] || continue
		rel="${line%%"$TAB"*}"
		src="${line#*"$TAB"}"
		validate_entity "$rel" "$src"
		dst="$ROOT/$rel"
		mkdir -p "$(dirname "$dst")"
		if [ -L "$dst" ]; then
			cur="$(readlink "$dst")"
			recorded="$(printf '%s\n' "$still_desired" | awk -F '\t' -v r="$rel" '$1 == r { print $2; exit }')"
			if [ "$cur" = "$src" ]; then
				final_state="${final_state}${rel}${TAB}${src}"$'\n'
				kept=$((kept + 1))
			elif [ -n "$recorded" ] && [ "$cur" = "$recorded" ]; then
				# Link still points where agent-kit last put it (recorded in
				# state) — safe to repoint at this checkout.
				ln -sfn "$src" "$dst"
				final_state="${final_state}${rel}${TAB}${src}"$'\n'
				msg "  relink  $rel"
				msg "            was: $cur"
				updated=$((updated + 1))
			else
				conflicts=$((conflicts + 1))
				msg "  conflict $rel"
				msg "    wants:  $src"
				msg "    target: $dst -> $cur"
				if state_mentions "$rel"; then
					msg "    this link was redirected manually; agent-kit released ownership and left it untouched."
				else
					msg "    unmanaged symlink; agent-kit never replaces links it does not own."
				fi
			fi
		elif [ -e "$dst" ]; then
			conflicts=$((conflicts + 1))
			msg "  conflict $rel"
			msg "    wants:  $src"
			msg "    target: $dst exists and is not a symlink"
			if state_mentions "$rel"; then
				msg "    a managed link was replaced by a real file; agent-kit released ownership and left it untouched."
			else
				msg "    agent-kit never overwrites real files or directories."
			fi
		else
			ln -s "$src" "$dst"
			final_state="${final_state}${rel}${TAB}${src}"$'\n'
			msg "  link    $rel"
			created=$((created + 1))
		fi
	done <<EOF
$desired
EOF

	printf '%s\n' "$final_state" | state_save

	msg "  $((created + updated + kept)) entity(ies) — $created created, $updated relinked, $kept up to date; $pruned pruned"
	if [ "$conflicts" -gt 0 ]; then
		msg "  $conflicts conflict(s) — conflicting targets were not touched"
		return 1
	fi
}

# --- uninstall ------------------------------------------------------------------

uninstall() {
	local removed=0 released=0 line rel src dst
	state_load

	while IFS= read -r line || [ -n "$line" ]; do
		[ -n "$line" ] || continue
		rel="${line%%"$TAB"*}"
		src="${line#*"$TAB"}"
		dst="$ROOT/$rel"
		if [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]; then
			rm "$dst"
			msg "  removed  $rel"
			removed=$((removed + 1))
		elif [ ! -e "$dst" ] && [ ! -L "$dst" ]; then
			msg "  gone     $rel"
		else
			msg "  released $rel (target changed externally; left untouched)"
			released=$((released + 1))
		fi
	done <<EOF
$STATE_OWN
EOF

	printf '' | state_save

	if [ "$removed" -eq 0 ] && [ "$released" -eq 0 ]; then
		msg "  no owned links"
	else
		msg "  removed $removed link(s), released $released (ownership forgotten)"
	fi
}

# --- status ----------------------------------------------------------------------

status() { # [<note>] — appended to the host line
	local desired total note="${1:-}"
	desired="$(entities)"
	total="$(printf '%s\n' "$desired" | line_count)"

	state_load
	local managed uptodate=0 stale=0 missing=0 foreign=0 line rel src dst cur
	managed="$(printf '%s' "$STATE_OWN" | line_count)"
	while IFS= read -r line || [ -n "$line" ]; do
		[ -n "$line" ] || continue
		rel="${line%%"$TAB"*}"
		src="${line#*"$TAB"}"
		dst="$ROOT/$rel"
		if [ -L "$dst" ]; then
			cur="$(readlink "$dst")"
			if printf '%s\n' "$desired" | awk -F '\t' -v r="$rel" -v s="$cur" '$1 == r && $2 == s { found = 1 } END { exit !found }'; then
				uptodate=$((uptodate + 1))
			elif [ "$cur" = "$src" ]; then
				stale=$((stale + 1))
			else
				foreign=$((foreign + 1))
			fi
		else
			missing=$((missing + 1))
		fi
	done <<EOF
$STATE_OWN
EOF

	printf '  %s root: %s%s\n' "$HOST" "$ROOT" "${note:+ ($note)}"
	printf '    repository wants %s entity(ies)\n' "$total"
	printf '    state: %s managed — %s up to date, %s relink needed, %s missing, %s redirected\n' \
		"$managed" "$uptodate" "$stale" "$missing" "$foreign"
	printf '    state file: %s\n' "$STATE_FILE"
}

status_all() {
	local h selected label
	selection_load
	selected="$SELECTION"
	if [ -z "$selected" ]; then
		selected="$HOSTS"
		label="default: nothing selected yet, a bare install installs every host"
	elif [ "$SELECTION_SOURCE" = recorded ]; then
		label="recorded in $SELECTION_FILE"
	else
		label="derived from existing links; recorded on the next install"
	fi
	msg "hosts: $selected ($label)"
	for h in $HOSTS; do
		use_host "$h"
		case " $selected " in
		*" $h "*) status ;;
		*)         status "not selected" ;;
		esac
	done

	command_state_load
	msg ""
	if [ -L "$LAUNCHER" ] && [ "$CMD_DST" = "$LAUNCHER" ]; then
		msg "command: $LAUNCHER -> $(readlink "$LAUNCHER")"
	elif [ -e "$LAUNCHER" ] || [ -L "$LAUNCHER" ]; then
		msg "command: $LAUNCHER (present, not managed by agent-kit)"
	else
		msg "command: not bootstrapped ($LAUNCHER)"
	fi
}

# --- launcher ----------------------------------------------------------------------

command_state_load() { # sets CMD_DST / CMD_SRC — ownership record for the launcher
	local line dst src
	CMD_DST=""
	CMD_SRC=""
	[ -f "$CMD_STATE_FILE" ] || return 0
	while IFS= read -r line || [ -n "$line" ]; do
		[ -n "$line" ] || continue
		dst="${line%%"$TAB"*}"
		src="${line#*"$TAB"}"
		if [ "$src" = "$line" ] || case "$src" in *"$TAB"*) true ;; *) false ;; esac || \
		   ! is_safe_source "$dst" || ! is_safe_source "$src"; then
			warn "ignoring invalid command state line: $line"
			continue
		fi
		CMD_DST="$dst"
		CMD_SRC="$src"
	done < "$CMD_STATE_FILE"
}

command_state_save() { # <dest> <src>; no arguments clears the record
	mkdir -p "$(dirname "$CMD_STATE_FILE")"
	if [ $# -eq 2 ]; then
		printf '%s%s%s\n' "$1" "$TAB" "$2" > "$CMD_STATE_FILE.tmp"
	else
		: > "$CMD_STATE_FILE.tmp"
	fi
	mv "$CMD_STATE_FILE.tmp" "$CMD_STATE_FILE"
}

bootstrap_self() { # own ~/.local/bin/agent-kit via its own ownership record
	local cur target="$REPO/bin/agent-kit"
	[ -f "$target" ] || { warn "no launcher at $target; command bootstrap skipped"; return 0; }
	command_state_load
	mkdir -p "$(dirname "$LAUNCHER")"
	if [ -L "$LAUNCHER" ]; then
		cur="$(readlink "$LAUNCHER")"
		if [ "$cur" = "$target" ]; then
			# Already correct: adopt it into ownership without touching it.
			[ "$CMD_DST" = "$LAUNCHER" ] && [ "$CMD_SRC" = "$target" ] || \
				command_state_save "$LAUNCHER" "$target"
		elif [ "$CMD_DST" = "$LAUNCHER" ] && [ "$cur" = "$CMD_SRC" ]; then
			# Ours, recorded, still where agent-kit left it — safe to repoint.
			ln -sfn "$target" "$LAUNCHER"
			command_state_save "$LAUNCHER" "$target"
			msg "  command $LAUNCHER"
			msg "            was: $cur"
		else
			# Foreign symlink, or ours that someone redirected: never touched.
			[ "$CMD_DST" = "$LAUNCHER" ] && command_state_save
			warn "$LAUNCHER -> $cur is not managed by agent-kit; command bootstrap skipped"
		fi
	elif [ -e "$LAUNCHER" ]; then
		[ "$CMD_DST" = "$LAUNCHER" ] && command_state_save
		warn "$LAUNCHER exists and is not a symlink; command bootstrap skipped"
	else
		ln -s "$target" "$LAUNCHER"
		command_state_save "$LAUNCHER" "$target"
		msg "  command $LAUNCHER -> $target"
	fi
}

# --- commands ----------------------------------------------------------------------

# cmd_install [<host>...] — host names are validated by the caller.
cmd_install() {
	local rc=0 h selected
	use_host pi
	migrate_legacy_state
	selection_load
	# shellcheck disable=SC2086 # word splitting of the host list is intended
	selected="$(host_list $SELECTION "$@")"
	# Nothing selected (fresh machine or an emptied selection): every host.
	[ -n "$selected" ] || selected="$HOSTS"
	for h in $HOSTS; do
		case " $selected " in
		*" $h "*) : ;;
		*) msg "Skipping $h (not selected; 'agent-kit install $h' adds it)"; continue ;;
		esac
		use_host "$h"
		msg "Installing ($HOST root: $ROOT):"
		reconcile || rc=1
	done
	# shellcheck disable=SC2086
	selection_save $selected
	bootstrap_self
	return "$rc"
}

cmd_uninstall() { # [<host>...] — validated by the caller; none means every host
	local h targets remaining=""
	use_host pi
	migrate_legacy_state
	# Read the selection before uninstalling: without a selection file it is
	# derived from the link state that uninstall is about to empty.
	selection_load
	if [ $# -eq 0 ]; then targets="$HOSTS"; else targets="$(host_list "$@")"; fi
	for h in $HOSTS; do
		case " $targets " in
		*" $h "*) : ;;
		*) continue ;;
		esac
		use_host "$h"
		msg "Uninstalling ($HOST root: $ROOT):"
		uninstall
	done
	if [ $# -eq 0 ]; then
		rm -f "$SELECTION_FILE"
	else
		for h in $SELECTION; do
			case " $targets " in
			*" $h "*) : ;;
			*) remaining="$remaining $h" ;;
			esac
		done
		# shellcheck disable=SC2086
		selection_save $remaining
	fi
	return 0
}

# --- task -------------------------------------------------------------------------
#
# Task-workspace CLI for hosts without pi extensions (Claude Code): the
# deterministic core under extensions/task-workspace, run by bun. JSON on
# stdout; see extensions/task-workspace/cli.ts for the contract.

cmd_task() {
	local cli="$REPO/extensions/task-workspace/cli.ts" bun
	bun="$(command -v bun || true)"
	if [ -z "$bun" ]; then
		# Hooks fail open: a missing runtime never disturbs the host session.
		[ "${1:-}" = "hook" ] && exit 0
		printf '{"status":"error","message":"agent-kit task requires bun on PATH"}\n'
		exit 1
	fi
	[ -f "$cli" ] || { printf '{"status":"error","message":"task-workspace CLI missing: %s"}\n' "$cli"; exit 1; }
	exec "$bun" "$cli" "$@"
}

# --- update -----------------------------------------------------------------------
#
# Bring the active checkout up to date and reconcile the managed links to
# the new tree in one command. Deliberately thin: git's own semantics for
# pull --ff-only (never clobbers a diverged or dirty checkout), then the
# same reconcile as install.

cmd_update() {
	if ! git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1; then
		die "update: $REPO is not a git checkout; there is nothing to pull"
	fi
	local branch upstream
	branch="$(git -C "$REPO" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
	if [ -z "$branch" ] || [ "$branch" = "HEAD" ]; then
		die "update: $REPO is in detached HEAD state; switch to a branch first"
	fi
	upstream="$(git -C "$REPO" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)"
	if [ -z "$upstream" ]; then
		die "update: branch '$branch' has no upstream; nothing to pull"
	fi
	msg "Updating $REPO ($branch from $upstream):"
	if ! git -C "$REPO" pull --ff-only; then
		die "update: 'git pull --ff-only' failed in $REPO; resolve it manually, then re-run 'agent-kit update'"
	fi
	# The pull may have changed this very script: reconcile with the updated
	# installer, never with the functions loaded before the pull.
	AGENT_KIT_ROOT="$REPO" exec "$REPO/bin/agent-kit" install
}

usage() {
	cat <<'EOF'
agent-kit — install the personal agent framework into Pi and Claude Code

Usage:
  agent-kit install [<host>...]
                        link the checkout into the selected hosts; named
                        hosts are added to the selection (default: all):
                        pi          -> ~/.pi/agent (skills, extensions,
                                       prompts, AGENTS.md)
                        claude-code -> ~/.claude (skills, rules/, the
                                       agent-kit plugin, commands/)
  agent-kit update      git pull --ff-only in this checkout, then reconcile
                        the selected hosts
  agent-kit uninstall [<host>...]
                        remove owned links of the named hosts and drop them
                        from the selection; without hosts: every host, and
                        the selection is cleared
  agent-kit status      show the host selection, link state and launcher
                        ownership
  agent-kit task <op>   task-workspace CLI (status, ensure, remove-lane,
                        teardown, commit, hook); JSON in, JSON out
  agent-kit help        this text

The repository layout is the desired state; entities are symlinked, never
copied. Install is a reconcile operation: re-running it from another
checkout or worktree repoints agent-kit's own links to that checkout.
Links and files agent-kit does not own are never touched, and neither
are the links of hosts that are not selected. The selection lives in
$XDG_STATE_HOME/agent-kit/hosts. State left by
older multi-runtime versions of agent-kit is migrated once: links
agent-kit provably owns are cleaned up or repointed, anything else is
released.
EOF
}

case "${1:-}" in
install)   shift; validate_hosts "$@"; cmd_install "$@" ;;
uninstall) shift; validate_hosts "$@"; cmd_uninstall "$@" ;;
update)    shift; [ $# -eq 0 ] || die "update takes no arguments (see: agent-kit help)"; cmd_update ;;
status)    shift; [ $# -eq 0 ] || die "status takes no arguments (see: agent-kit help)"; status_all ;;
task)      shift; cmd_task "$@" ;;
-h|--help|help) usage ;;
"")        usage ;;
*)         die "unknown command '$1' (try: install, uninstall, update, status, task, help)" ;;
esac
