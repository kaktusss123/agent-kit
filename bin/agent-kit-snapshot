#!/usr/bin/env bash
#
# agent-kit snapshot — the Bash implementation of `agent-kit snapshot`.
#
# TEMPORARY BRIDGE. Every other command lives in bin/agent-kit (Node.js);
# snapshot keeps its current Bash writer until it is ported, and bin/agent-kit
# delegates this one command here (see the delegation in bin/agent-kit). This
# file exists only for that delegation: no other caller, and nothing here may
# grow new behavior. Delete the file and its delegation together.
#
# Snapshot semantics, locking, retention and validation are the ones documented
# below; they are unchanged by the move out of the old monolithic installer.

set -euo pipefail

# --- locate the repository --------------------------------------------------
#
# The checkout is found through this script (following symlinks), exactly like
# bin/agent-kit: the tests and sandboxes point the installer at another tree
# with AGENT_KIT_ROOT.

SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
	_link="$(readlink "$SELF")"
	case "$_link" in
	/*) SELF="$_link" ;;
	*)  SELF="$(dirname "$SELF")/$_link" ;;
	esac
done
SCRIPT_DIR="$(cd "$(dirname "$SELF")" && pwd -P)"
REPO="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || printf '%s/..' "$SCRIPT_DIR")"
REPO="$(cd "$REPO" && pwd -P)"
REPO="${AGENT_KIT_ROOT:-$REPO}"

msg()  { printf '%s\n' "$*"; }
warn() { printf 'warning: %s\n' "$*" >&2; }
die()  { printf 'error: %s\n' "$*" >&2; exit 2; }

[ -d "$REPO" ] || die "repository root not found: $REPO"

# Content-addressed release snapshots for hosts that must not read the live
# checkout (headless sessions run pi with --no-extensions and explicit -e
# paths into <releases>/current/extensions).
#
# Layout: <releases>/<full HEAD sha>/{extensions,node_modules,manifest.json};
# <releases>/current is a relative symlink to a complete snapshot and the
# only mutable path. A snapshot is built in <releases>/.tmp-<sha>-<pid> and
# renamed to its final name, so a directory under a final name is complete by
# construction; current is flipped by renaming a symlink over it only after
# the target reached its final name.
#
# Snapshot content is the checkout's working tree at HEAD (uncommitted changes
# are recorded as dirty in the manifest, not fatal). extensions/ is a real
# copy. node_modules/ is a hardlink copy of the previous current snapshot (or
# of the checkout's own node_modules on the first sync), with a real copy as
# fallback when hardlinking fails (e.g. across filesystems). Snapshot files are
# never rewritten in place, which makes shared inodes safe. Retention keeps
# current's target plus the newest 5 snapshots and prunes older directories;
# task worktrees may still link into pruned node_modules, that grace is
# accepted.
#
# Concurrency: every operation on a releases directory (materialize, flip and
# prune included) runs under one exclusive lock, so concurrent invocations
# cannot interleave a flip with a prune that was decided against an older
# current. Where flock(1) exists (GNU/Linux) the lock is an exclusive flock on
# <releases>/.lock; elsewhere (macOS and other BSD userlands, where flock(1) is
# not part of the base system) it is an atomic mkdir of <releases>/.lock.d that
# records its owner and is released on exit. A mkdir lock can outlive a
# SIGKILLed holder, so a lock directory older than
# AGENT_KIT_SNAPSHOT_LOCK_STALE seconds (600 by default) is taken over; a
# takeover only moves the directory whose owner line it measured as stale, and
# only into an aside name proven free. A plain mv NESTS the source into a
# destination that appeared in the check-to-move window, so every lock move
# detects that nest right after the mv and undoes it with rename(2), which
# cannot nest a directory; a nest that cannot be undone is a loud error naming
# the nested path, never a silent restore of a corrupted layout. A holder whose
# lock was displaced anyway dies loudly
# before touching the releases dir again, because a mkdir lock is not a kernel
# descriptor lock and must not be trusted blindly. Releasing the lock is the
# same kind of validated move; the only unresolvable case is a third process
# taking the freed name before a displaced lock is put back, and that dies
# loudly naming the aside and the displaced owner, never silently. Both kinds
# wait boundedly (60 s by default, AGENT_KIT_SNAPSHOT_LOCK_TIMEOUT overrides
# it); a lock that cannot be taken in time is a bounded error, never a silent
# continue. AGENT_KIT_SNAPSHOT_LOCK (auto by default) forces the mechanism for
# tests. Every local of a lock primitive is initialized at its declaration:
# bash 4.4 and later leave a bare `local name` UNSET, so `set -u` aborts on the
# first read of a name that only an error branch would have assigned, which
# turns a bounded death message into an "unbound variable" crash (bash 3.2
# treats the same name as set to empty, so the bug is invisible on macOS).
#
# The runtime is feature-detected, never assumed: BSD userland has no cp -a
# --link, no cp --link, no mv -T and no stat -c, so hardlink copies fall back
# to pax -rwl (or a real copy), the current flip uses a rename(2) issued
# through perl (BSD mv -h unlinks the old link first and plain -f would follow
# it into the snapshot directory), the publish rename asks rename(2) for a
# non-replacing move as well (GNU mv -T, else perl; rename of a directory onto
# an existing non-empty directory fails with ENOTEMPTY, which is the conflict
# semantics the GNU path always had, whereas plain mv nests the source inside
# the target), and mtimes are read with stat -f %m.
#
# Prune failures are not fatal (an undeletable old snapshot must not break the
# "current points at a complete snapshot of HEAD" contract): they produce
# exactly one bounded warning line and the command still exits 0.
#
# A directory under a final name is trusted only after a strict check:
# extensions/subagents/index.ts present, node_modules providing the Pi runtime
# packages, and a manifest that parses as exactly the five fields this writer
# emits. Anything else is an incomplete artifact and is refused, never flipped
# to.

SNAPSHOT_KEEP=5
# extensions/subagents/index.ts marks a complete extensions/ tree: it ships in
# every host install and a copy without it is not an agent-kit extension set.
SNAPSHOT_EXT_MARKER="extensions/subagents/index.ts"
SNAPSHOT_LOCK_TIMEOUT="${AGENT_KIT_SNAPSHOT_LOCK_TIMEOUT:-60}"
SNAPSHOT_LOCK_STALE="${AGENT_KIT_SNAPSHOT_LOCK_STALE:-600}"
# auto (feature-detect), flock or mkdir. The forced values exist so tests can
# exercise both mechanisms on one host; auto is the only production default.
SNAPSHOT_LOCK_MODE="${AGENT_KIT_SNAPSHOT_LOCK:-auto}"
SNAPSHOT_RELEASES=""
SNAPSHOT_TMP=""
# Nested tree a failed last-resort publish rename could not move back: it is
# our own build left inside a published snapshot, and the caller destroys it in
# place. Empty when no rename nested a tree.
SNAPSHOT_NESTED=""
# mkdir-lock directory this process holds; empty when flock is in use.
SNAPSHOT_LOCK_DIR=""
# The owner line this process wrote into SNAPSHOT_LOCK_DIR: "<pid>\t<stamp>".
SNAPSHOT_LOCK_TOKEN=""
# Takeover claim this process holds while it replaces a stale lock; empty when
# no takeover is in flight.
SNAPSHOT_LOCK_CLAIM=""
# Probed once per invocation by the helpers below ("" = not probed yet).
SNAPSHOT_STAT_STYLE=""

snapshot_cleanup() {
	snapshot_lock_claim_release
	if [ -n "$SNAPSHOT_TMP" ]; then
		# The temporary tree normally sits directly in the releases dir. A
		# last-resort publish rename that nested it inside the target leaves it
		# one level deeper (SNAPSHOT_TMP is repointed at that path), and cleanup
		# must still reach it instead of leaving a .tmp-* inside a published
		# snapshot.
		case "$SNAPSHOT_TMP" in
		"$SNAPSHOT_RELEASES"/.tmp-*|"$SNAPSHOT_RELEASES"/*/.tmp-*)
			snapshot_remove_tree "$SNAPSHOT_TMP" || \
				warn "snapshot: could not remove the temporary directory $(snapshot_bounded "$SNAPSHOT_TMP" 160); remove it manually"
			;;
		esac
		SNAPSHOT_TMP=""
	fi
	snapshot_unlock
	return 0
}

snapshot_bounded() { # <text> [<max>] — one line, length-capped for diagnostics
	local text="$1" max="${2:-120}"
	if [ "${#text}" -gt "$max" ]; then
		text="${text:0:$max}..."
	fi
	# A diagnostic must stay one line: strip every control character.
	printf '%s' "$text" | tr -d '[:cntrl:]'
}

snapshot_make_writable() { # <path> — best-effort recursive u+rwX before a removal
	# cp -a preserves modes such as 0555, and rm cannot descend into a
	# directory it cannot write to. Split out of snapshot_remove_tree so a
	# caller that must re-check something right before the destructive call can
	# run this (slow, recursive) walk first and keep the check-to-rm window to a
	# fork and an exec.
	local path="$1"
	[ -d "$path" ] && [ ! -L "$path" ] || return 0
	# No "--" here: BSD chmod reads it as a file name, and $path is a resolved
	# absolute path, so it cannot be mistaken for an option.
	chmod -R u+rwX "$path" 2>/dev/null || true
	return 0
}

snapshot_remove_tree() { # <path> — remove a tree, restoring write permission first
	local path="$1"
	[ -e "$path" ] || [ -L "$path" ] || return 0
	snapshot_make_writable "$path"
	snapshot_remove_tree_now "$path"
}

snapshot_remove_tree_now() { # <path> — remove an already-writable tree in one rm
	# For callers that run a (slow, recursive) permission walk before their last
	# ownership check: after that check the only work before the unlink must be
	# the fork and exec of rm itself, so this variant never walks. Failure is
	# reported, not swallowed: rm cannot descend into a directory it cannot
	# write to, and the caller turns that into a bounded warning.
	local path="$1"
	[ -e "$path" ] || [ -L "$path" ] || return 0
	rm -rf -- "$path" 2>/dev/null || true
	if [ -e "$path" ] || [ -L "$path" ]; then
		return 1
	fi
	return 0
}

snapshot_have_flock() { # true when a runnable flock(1) is on PATH
	# command -v alone is not enough: a non-executable file of that name in
	# PATH is reported by some shells and then fails at exec time.
	local path
	path="$(command -v flock 2>/dev/null)" || return 1
	[ -n "$path" ] && [ -x "$path" ]
}

snapshot_stat_style() { # cached: gnu | bsd — which stat(1) dialect this host has
	[ -n "$SNAPSHOT_STAT_STYLE" ] && return 0
	if stat -c %Y / >/dev/null 2>&1; then
		SNAPSHOT_STAT_STYLE=gnu
	elif stat -f %m / >/dev/null 2>&1; then
		SNAPSHOT_STAT_STYLE=bsd
	else
		SNAPSHOT_STAT_STYLE=none
	fi
	return 0
}

snapshot_mtime() { # <path> — mtime in epoch seconds, 0 when unknown
	snapshot_stat_style
	case "$SNAPSHOT_STAT_STYLE" in
	gnu) stat -c %Y -- "$1" 2>/dev/null || printf 0 ;;
	bsd) stat -f %m "$1" 2>/dev/null || printf 0 ;;
	*) printf 0 ;;
	esac
}

snapshot_cp_archive() { # <src> <dst> — recursive copy, modes kept, links kept
	# cp -a is GNU and also accepted by recent macOS; BSD cp -Rp is the
	# portable equivalent (no dereference, modes and timestamps preserved).
	if cp -a -- "$1" "$2" 2>/dev/null; then
		return 0
	fi
	cp -Rp "$1" "$2" 2>/dev/null
}

snapshot_cp_deref() { # <src> <dst> — real copy with symlinks dereferenced
	if cp -aL -- "$1" "$2" 2>/dev/null; then
		return 0
	fi
	snapshot_remove_tree "$2" || true
	cp -RL "$1" "$2" 2>/dev/null
}

snapshot_stray_symlink() { # <path> — first symlink left in a materialized tree
	# A snapshot's node_modules must hold no symlinks: the copy dereferences
	# them. pax -L leaves a dangling link in place instead of failing, so the
	# result is checked instead of trusting the exit code alone.
	find "$1" -type l -print 2>/dev/null | sed -n 1p
}

snapshot_hardlink_tree() { # <src> <dst> — hardlink copy of a tree, links dereferenced
	# GNU coreutils does it in one call. BSD cp has no --link at all, so the
	# pax fallback hardlinks against the source while -L dereferences the
	# links inside it; a real copy remains the caller's last resort.
	if cp -aL --link -- "$1" "$2" 2>/dev/null; then
		return 0
	fi
	if command -v pax >/dev/null 2>&1; then
		snapshot_remove_tree "$2" || true
		if mkdir -- "$2" 2>/dev/null; then
			if (cd -- "$1" && pax -rwLl . "$2" >/dev/null 2>&1); then
				if [ -z "$(snapshot_stray_symlink "$2")" ]; then
					return 0
				fi
			fi
			snapshot_remove_tree "$2" || true
		fi
	fi
	return 1
}

snapshot_have_perl() { # true when a runnable perl is on PATH (rename tier)
	local path
	path="$(command -v perl 2>/dev/null)" || return 1
	[ -n "$path" ] && [ -x "$path" ]
}

snapshot_rename_link() { # <temp-link> <current> — replace the link in one rename
	# Replacing a symlink atomically needs rename(2) on the link path itself
	# (rename over a symlink never follows it). GNU mv has -T for that. BSD mv
	# reads -T as an illegal option, plain -f follows a link that points at a
	# directory (it would move the new link INTO the snapshot), and -h unlinks
	# the old link before renaming, which leaves a window where current does not
	# exist. perl is in the macOS base system, so its rename(2) is the portable
	# atomic tier; mv -h remains the last resort.
	mv -Tf -- "$1" "$2" 2>/dev/null && return 0
	if snapshot_have_perl; then
		perl -e 'exit(rename($ARGV[0], $ARGV[1]) ? 0 : 1)' "$1" "$2" 2>/dev/null && return 0
	fi
	mv -fh "$1" "$2" 2>/dev/null
}

snapshot_rename_dir() { # <src> <dst> — move a built directory under its final name
	# The publish rename must never nest the source inside the target: plain mv
	# does exactly that when <dst> appears between the caller's check and the
	# move, which would mutate a published (immutable) snapshot and then let the
	# completeness check validate the pre-existing content. rename(2) refuses to
	# replace a non-empty directory (ENOTEMPTY), which is the conflict semantics
	# the GNU path always had, so the same tiers as the current flip are used:
	# GNU mv -T, then perl rename(2), then a guarded plain mv that detects
	# nesting, undoes it and reports a conflict.
	local src="$1" dst="$2" base nested
	base="${src##*/}"
	SNAPSHOT_NESTED=""
	mv -T -- "$src" "$dst" 2>/dev/null && return 0
	if [ -e "$dst" ] || [ -L "$dst" ]; then
		return 1
	fi
	if snapshot_have_perl; then
		perl -e 'exit(rename($ARGV[0], $ARGV[1]) ? 0 : 1)' "$src" "$dst" 2>/dev/null && return 0
	fi
	if [ -e "$dst" ] || [ -L "$dst" ]; then
		return 1
	fi
	mv -- "$src" "$dst" 2>/dev/null || return 1
	nested="$dst/$base"
	if [ -d "$nested" ]; then
		# Last resort only: the target directory appeared under our feet and the
		# plain mv put the source INSIDE it. Plain mv is used for lock asides
		# too, so the nested path is reported through SNAPSHOT_NESTED instead of
		# being destroyed here: only the publish caller knows that the tree is
		# its own build and may be removed in place.
		if mv -- "$nested" "$src" 2>/dev/null; then
			return 1
		fi
		SNAPSHOT_NESTED="$nested"
		return 1
	fi
	return 0
}

snapshot_lock_age() { # <dir> — seconds since the mkdir lock was taken, empty if unknown
	# The recorded owner line is authoritative; the directory mtime is the
	# fallback for a holder that died between mkdir and the owner write.
	local dir="$1" ts="" now=""
	if [ -f "$dir/owner" ]; then
		read -r _ ts < "$dir/owner" 2>/dev/null || ts=""
	fi
	case "$ts" in
	""|*[!0-9]*) ts="$(snapshot_mtime "$dir")" ;;
	esac
	case "$ts" in
	""|*[!0-9]*) return 0 ;;
	esac
	now="$(date +%s)"
	if [ "$now" -le "$ts" ]; then
		printf 0
		return 0
	fi
	printf '%s' "$((now - ts))"
}

snapshot_lock_mkdir() { # <dir> — atomic mkdir lock, bounded wait, stale takeover
	# mkdir is the one atomic primitive every userland has. Semantics are
	# weaker than a kernel descriptor lock: a SIGKILLed holder leaves the
	# directory behind, so a directory older than SNAPSHOT_LOCK_STALE is moved
	# aside and the mkdir race restarts. Ownership is always a successful
	# mkdir, so a takeover can only hand the lock to one process as long as a
	# takeover removes nothing but the lock it measured as stale
	# (snapshot_lock_takeover).
	# Death paths read locals that only some branches assign, so all of them are
	# initialized here (see the lock protocol note above).
	local dir="$1" deadline="" now="" age="" vanished=0
	deadline=$(($(date +%s) + SNAPSHOT_LOCK_TIMEOUT))
	while :; do
		if mkdir -- "$dir" 2>/dev/null; then
			SNAPSHOT_LOCK_DIR="$dir"
			SNAPSHOT_LOCK_TOKEN="$$"$'\t'"$(date +%s)"
			if ! printf '%s\n' "$SNAPSHOT_LOCK_TOKEN" > "$dir/owner" 2>/dev/null; then
				SNAPSHOT_LOCK_DIR=""
				SNAPSHOT_LOCK_TOKEN=""
				snapshot_remove_tree "$dir" || true
				die "snapshot: cannot write the lock owner file in $dir"
			fi
			return 0
		fi
		if [ ! -d "$dir" ]; then
			# The holder can release between our failed mkdir and this check: the
			# lock is free and the next mkdir usually wins it, so an ordinary
			# release race is retried instead of dying. The counter keeps a
			# genuinely uncreatable path failing fast: three consecutive mkdir
			# failures with the name still absent (a missing parent, a
			# non-directory path) are not a release race.
			vanished=$((vanished + 1))
			if [ "$vanished" -ge 3 ]; then
				die "snapshot: cannot create the lock directory $dir"
			fi
			continue
		fi
		vanished=0
		age="$(snapshot_lock_age "$dir")"
		if [ "${age:-0}" -ge "$SNAPSHOT_LOCK_STALE" ]; then
			if snapshot_lock_takeover "$dir"; then
				continue
			fi
		fi
		now="$(date +%s)"
		if [ "$now" -ge "$deadline" ]; then
			die "snapshot: could not lock $dir in ${SNAPSHOT_LOCK_TIMEOUT}s (another snapshot is running, or a stale lock could not be taken over); retry later"
		fi
		sleep 1
	done
}

snapshot_lock_free_aside() { # <base> — a free aside name for a lock move, empty when none is free
	# Every lock move is a rename, and plain mv NESTS the source into an existing
	# destination directory. The destination is therefore proven absent with one
	# cheap test instead of being cleared by a recursive removal: that removal
	# would put a walk into the window between the ownership check and the move,
	# and when it failed the move nested the lock into the leftover directory
	# (.lock.d/.lock.d). A leftover aside of this very process (a release or a
	# takeover that failed after the move) is skipped by the numeric suffix.
	local base="$1" n=0 candidate=""
	while [ "$n" -lt 8 ]; do
		if [ "$n" -eq 0 ]; then
			candidate="$base"
		else
			candidate="$base-$n"
		fi
		if [ ! -e "$candidate" ] && [ ! -L "$candidate" ]; then
			printf '%s' "$candidate"
			return 0
		fi
		n=$((n + 1))
	done
	return 1
}

snapshot_lock_move() { # <src> <dst> — move a lock directory without leaving a nest
	# The release and the takeover both move a lock directory to an aside name
	# that was proven free with one cheap test. Plain mv is the one rename every
	# userland has, but it NESTS the source into a destination directory that
	# appeared in that window, which would turn .lock.d into
	# .lock.d.release-<pid>/.lock.d and let the later restore move the whole
	# nested aside back. The nest is therefore detected right after the mv and
	# undone through rename(2) (perl, else GNU mv -T), which refuses to replace
	# an existing directory and cannot nest a second time. Returns 0 when the
	# move was clean, 1 when <dst> was taken; a nest that cannot be undone dies
	# loudly, naming the nested path, because a restore of that layout would be
	# corruption.
	local src="$1" dst="$2" base="" nested="" left="" claim="" note=""
	base="${src##*/}"
	mv -- "$src" "$dst" 2>/dev/null || return 1
	nested="$dst/$base"
	[ -d "$nested" ] || return 0
	if snapshot_have_perl; then
		perl -e 'exit(rename($ARGV[0], $ARGV[1]) ? 0 : 1)' "$nested" "$src" 2>/dev/null || true
	elif [ ! -e "$src" ] && [ ! -L "$src" ]; then
		mv -T -- "$nested" "$src" 2>/dev/null || true
	fi
	if [ -d "$src/$base" ]; then
		left="$src/$base"
	elif [ -d "$nested" ]; then
		left="$nested"
	fi
	if [ -z "$left" ]; then
		return 1
	fi
	# Every death path releases the takeover claim; if even that removal fails,
	# the bounded message names it instead of leaving an unnamed artifact.
	claim="$SNAPSHOT_LOCK_CLAIM"
	snapshot_lock_claim_release
	if [ -n "$claim" ] && { [ -e "$claim" ] || [ -L "$claim" ]; }; then
		note="; the takeover claim at $claim could not be removed"
	fi
	die "snapshot: could not move the lock $src to $dst: the aside name was taken while the move was in flight and the lock ended up nested at $left$note; move $left back to $src manually, remove $dst, then retry"
}

snapshot_lock_owner_line() { # <dir> — the owner line a mkdir lock carries, empty if absent
	local line=""
	[ -f "$1/owner" ] || return 0
	# read is used instead of head/tail so no BSD tool has to parse "--".
	IFS= read -r line < "$1/owner" 2>/dev/null || true
	printf '%s' "$line"
}

snapshot_lock_takeover() { # <dir> — take over the lock <dir> only if it is still the stale one
	# Two waiters can measure the same stale lock before either moves it: the
	# second would then move the freshly created lock of the first and both
	# would believe they hold the lock. Two guards close that hole:
	#   1. a takeover claim (an atomic mkdir of <dir>.taking) serializes takers,
	#      so a second waiter re-measures instead of moving a fresh lock;
	#   2. the owner line, which must still be exactly the line measured as
	#      stale in the directory that ends up aside. If it is not, a lock this
	#      process did not measure was displaced and is put back as it was.
	# Returns 0 only when a provably stale lock was removed.
	local dir="$1" claim="$1.taking" aside="" measured="" age="" owner="" claim_age=""
	if ! mkdir -- "$claim" 2>/dev/null; then
		# A claim is held for a few syscalls, so a leftover one means its taker
		# was killed; the same age rule as for the lock clears it. A claim
		# directory is empty by construction, so it is removed in one rm: no
		# recursive walk runs between the age measurement and the removal.
		claim_age="$(snapshot_lock_age "$claim")"
		if [ "${claim_age:-0}" -ge "$SNAPSHOT_LOCK_STALE" ]; then
			snapshot_remove_tree_now "$claim" || true
		fi
		return 1
	fi
	SNAPSHOT_LOCK_CLAIM="$claim"
	measured="$(snapshot_lock_owner_line "$dir")"
	age="$(snapshot_lock_age "$dir")"
	if [ "${age:-0}" -lt "$SNAPSHOT_LOCK_STALE" ]; then
		snapshot_lock_claim_release
		return 1
	fi
	# mv nests into an existing directory, so the aside name must be free first.
	# Only a cheap existence test runs here: a recursive cleanup would widen the
	# window between the measurement above and the move.
	if ! aside="$(snapshot_lock_free_aside "$1.stale-$$")"; then
		snapshot_lock_claim_release
		return 1
	fi
	if ! snapshot_lock_move "$dir" "$aside"; then
		snapshot_lock_claim_release
		return 1
	fi
	# The write-permission walk runs before the owner re-read below, so the work
	# between that check and the removal is one rm.
	snapshot_make_writable "$aside"
	owner="$(snapshot_lock_owner_line "$aside")"
	if [ "$owner" != "$measured" ]; then
		snapshot_lock_restore "$aside" "$dir" "$owner"
		snapshot_lock_claim_release
		return 1
	fi
	if ! snapshot_remove_tree_now "$aside"; then
		# The snapshot itself is intact — the stale lock was provably taken
		# over — but a leftover aside needs a human: name it instead of
		# leaving an unnamed artifact behind.
		warn "snapshot: the taken-over stale lock $aside could not be removed; remove it manually"
	fi
	snapshot_lock_claim_release
	return 0
}

snapshot_lock_claim_release() { # drop the takeover claim this process holds
	[ -n "$SNAPSHOT_LOCK_CLAIM" ] || return 0
	snapshot_remove_tree_now "$SNAPSHOT_LOCK_CLAIM" || true
	SNAPSHOT_LOCK_CLAIM=""
	return 0
}

snapshot_lock_restore() { # <aside> <dir> <owner> — put back a lock displaced by mistake
	# Never reached on a well-behaved releases dir: it means a lock that was not
	# this process's was moved aside (a second waiter took over a lock created
	# after it measured the stale one, or an age-based takeover slipped in
	# between the owner read and the release move). The displaced holder lost its
	# lock for one rename at most, so it is restored immediately through the
	# non-nesting rename tiers. When a third acquirer took the name in that
	# window the restore cannot succeed, and the failure is loud and bounded: it
	# names the aside that holds the displaced live lock and that lock's owner
	# line, instead of silently leaving two processes believing they hold it.
	local owner="" claim="$SNAPSHOT_LOCK_CLAIM" note=""
	if snapshot_lock_move "$1" "$2"; then
		return 0
	fi
	# Every death path releases the takeover claim; if even that removal fails,
	# the bounded message names it instead of leaving an unnamed artifact.
	snapshot_lock_claim_release
	if [ -n "$claim" ] && { [ -e "$claim" ] || [ -L "$claim" ]; }; then
		note="; the takeover claim at $claim could not be removed"
	fi
	owner="$(snapshot_bounded "${3:-unknown}" 60)"
	die "snapshot: could not put the displaced lock back under $2: another process acquired that name meanwhile; the displaced live lock is at $1 (owner line: $owner)$note; stop the process named there or remove whichever lock is stale, then retry"
}

snapshot_lock_held() { # true when SNAPSHOT_LOCK_DIR still carries this process's owner line
	[ -n "$SNAPSHOT_LOCK_DIR" ] && [ -n "$SNAPSHOT_LOCK_TOKEN" ] || return 1
	[ "$(snapshot_lock_owner_line "$SNAPSHOT_LOCK_DIR")" = "$SNAPSHOT_LOCK_TOKEN" ]
}

snapshot_lock_verify() { # <section> — fail loudly unless this process still owns the mkdir lock
	# A mkdir lock can be taken over, so a holder re-reads its own owner line
	# before every critical section instead of writing to a releases dir it may
	# no longer own. A lock displaced and restored by a failed takeover is gone
	# for one rename (microseconds), so a short retry separates that from a real
	# loss; a real loss is a loud, bounded failure, never a silent continue.
	[ -n "$SNAPSHOT_LOCK_DIR" ] || return 0
	local i=0
	while ! snapshot_lock_held; do
		i=$((i + 1))
		if [ "$i" -gt 20 ]; then
			die "snapshot: lost the lock $SNAPSHOT_LOCK_DIR to another process before $1; stopping instead of writing to a releases dir this process does not lock"
		fi
		sleep 0.05 2>/dev/null || sleep 1
	done
	return 0
}

snapshot_unlock() { # release the mkdir lock by moving it aside and validating it
	# Releasing is a validated MOVE, not a delete: between any ownership check
	# and an rm an age-based takeover can replace the lock, and the rm would
	# then destroy the NEW holder's lock while it is still working. One rename
	# is atomic, so exactly one process can move a given lock instance away, and
	# the owner line of what landed aside says whose lock it was.
	#
	# The aside name is proven free with one cheap existence test; it is never
	# cleared by a recursive removal. That removal used to widen the window
	# between the owner read and the move, and when it failed the move nested the
	# lock into the leftover directory, so the release then "restored" the wrong
	# structure (.lock.d/.lock.d). A lock that already belongs to another process
	# is not moved at all; a takeover that slips in after the read is put back at
	# once, and a restore that loses the name to a third acquirer dies loudly.
	[ -n "$SNAPSHOT_LOCK_DIR" ] || return 0
	local dir="$SNAPSHOT_LOCK_DIR" token="$SNAPSHOT_LOCK_TOKEN"
	local aside="" owner="" bounded_owner=""
	SNAPSHOT_LOCK_DIR=""
	SNAPSHOT_LOCK_TOKEN=""
	if ! aside="$(snapshot_lock_free_aside "$dir.release-$$")"; then
		warn "snapshot: cannot release the mkdir lock $dir: every aside name up to $dir.release-$$-7 is taken; leaving it in place, remove it manually"
		return 0
	fi
	# One cheap read, then one rename, then the validation of what landed aside.
	owner="$(snapshot_lock_owner_line "$dir")"
	if [ -z "$owner" ]; then
		warn "snapshot: the mkdir lock $dir was already gone when this process released it; nothing was removed"
		return 0
	fi
	if [ "$owner" != "$token" ]; then
		warn "snapshot: $dir is no longer owned by this process ($(snapshot_bounded "$owner" 60)); leaving it in place"
		return 0
	fi
	if ! snapshot_lock_move "$dir" "$aside"; then
		if [ "$(snapshot_lock_owner_line "$dir")" = "$token" ]; then
			warn "snapshot: could not release the mkdir lock $dir: the chosen aside name $aside was taken while the release was in flight; the lock stays in place, remove it manually"
		else
			warn "snapshot: the mkdir lock $dir was already gone or replaced when this process released it; nothing was removed"
		fi
		return 0
	fi
	# The permission walk and every diagnostic string are prepared before the
	# owner re-read below: snapshot_bounded pipes through an external tr, and
	# that fork between the re-read and the rm would let this process remove a
	# replacement owner it never compared. After the final re-read only the
	# comparison and one fork/exec (rm, or the restore's rename) run.
	snapshot_make_writable "$aside"
	owner="$(snapshot_lock_owner_line "$aside")"
	bounded_owner="$(snapshot_bounded "$owner" 60)"
	owner="$(snapshot_lock_owner_line "$aside")"
	if [ "$owner" != "$token" ]; then
		# Not the destructive path, so the diagnostic may be refreshed from the
		# line the comparison really saw: that fork cannot precede a removal.
		bounded_owner="$(snapshot_bounded "$owner" 60)"
		warn "snapshot: $dir is no longer owned by this process ($bounded_owner); putting the displaced lock back in place"
		snapshot_lock_restore "$aside" "$dir" "$owner"
		return 0
	fi
	snapshot_remove_tree_now "$aside" || \
		warn "snapshot: could not remove the released lock $aside; remove it manually"
	return 0
}

snapshot_lock() { # <releases> — exclusive lock for the whole command (fd 9)
	local lock="$1/.lock"
	case "$SNAPSHOT_LOCK_TIMEOUT" in
	""|*[!0-9]*)
		die "snapshot: AGENT_KIT_SNAPSHOT_LOCK_TIMEOUT must be a whole number of seconds"
		;;
	esac
	case "$SNAPSHOT_LOCK_STALE" in
	""|*[!0-9]*)
		die "snapshot: AGENT_KIT_SNAPSHOT_LOCK_STALE must be a whole number of seconds"
		;;
	esac
	case "$SNAPSHOT_LOCK_MODE" in
	auto)
		if snapshot_have_flock; then
			SNAPSHOT_LOCK_MODE=flock
		else
			SNAPSHOT_LOCK_MODE=mkdir
		fi
		;;
	flock)
		snapshot_have_flock || \
			die "snapshot: AGENT_KIT_SNAPSHOT_LOCK=flock needs a runnable flock(1) on PATH (GNU/Linux ships one; BSD userlands do not)"
		;;
	mkdir) : ;;
	*)
		die "snapshot: AGENT_KIT_SNAPSHOT_LOCK must be auto, flock or mkdir"
		;;
	esac
	if [ "$SNAPSHOT_LOCK_MODE" = mkdir ]; then
		# BSD userlands ship no flock(1); the mkdir lock above is the fallback.
		snapshot_lock_mkdir "$lock.d"
		return 0
	fi
	: >>"$lock" 2>/dev/null || die "snapshot: cannot create the lock file $lock"
	# The descriptor stays open until the process exits: the kernel drops the
	# lock then, including after SIGKILL.
	exec 9>>"$lock" || die "snapshot: cannot open the lock file $lock"
	if ! flock -w "$SNAPSHOT_LOCK_TIMEOUT" 9; then
		die "snapshot: could not lock $lock in ${SNAPSHOT_LOCK_TIMEOUT}s (another snapshot is running, or the filesystem does not support flock); retry later"
	fi
}

snapshot_json_escape() { # <text> — JSON string body; checkout paths cannot hold NUL
	# Escapes the characters that can appear in a path: backslash, double
	# quote, newline, carriage return, tab, backspace and form feed. Other
	# control characters are not expected in a checkout path; the manifest
	# validator rejects them instead of quietly emitting invalid JSON.
	local text="$1"
	text="${text//\\/\\\\}"
	text="${text//\"/\\\"}"
	text="${text//$'\n'/\\n}"
	text="${text//$'\r'/\\r}"
	text="${text//$'\t'/\\t}"
	text="${text//$'\b'/\\b}"
	text="${text//$'\f'/\\f}"
	printf '%s' "$text"
}

snapshot_json_string_valid() { # <json string body> — exactly the escapes we emit
	# Other control characters are not expected in a checkout path, so the
	# manifest validator rejects them instead of escaping them.
	local body="$1" i=0 ch
	case "$body" in
	*[[:cntrl:]]*) return 1 ;;
	esac
	while [ "$i" -lt "${#body}" ]; do
		ch="${body:i:1}"
		case "$ch" in
		'"') return 1 ;;
		\\)
			i=$((i + 1))
			case "${body:i:1}" in
			'"'|\\|/|b|f|n|r|t) : ;;
			*) return 1 ;;
			esac
			;;
		esac
		i=$((i + 1))
	done
	return 0
}

snapshot_manifest_valid() { # <manifest> <sha> — strict parse of the 5 known fields
	local manifest="$1" sha="$2" line n=0 body
	local re_sha="^  \"sha\": \"$sha\",\$"
	local re_dirty='^  "dirty": (true|false),$'
	local re_created='^  "createdAt": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z",$'
	[ -f "$manifest" ] && [ -r "$manifest" ] || return 1
	while IFS= read -r line || [ -n "$line" ]; do
		n=$((n + 1))
		case "$n" in
		1) [ "$line" = "{" ] || return 1 ;;
		2) [ "$line" = '  "schema": 1,' ] || return 1 ;;
		3) [[ "$line" =~ $re_sha ]] || return 1 ;;
		4) [[ "$line" =~ $re_dirty ]] || return 1 ;;
		5) [[ "$line" =~ $re_created ]] || return 1 ;;
		6)
			case "$line" in
			'  "source": "'*'"') : ;;
			*) return 1 ;;
			esac
			body="${line#'  "source": "'}"
			body="${body%\"}"
			snapshot_json_string_valid "$body" || return 1
			;;
		7) [ "$line" = "}" ] || return 1 ;;
		*) return 1 ;;
		esac
	done < "$manifest"
	[ "$n" -eq 7 ]
}

snapshot_has_packages() { # <node_modules> — runtime packages the extensions import
	local nm="$1"
	[ -d "$nm/@earendil-works/pi-coding-agent" ] &&
		[ -d "$nm/@earendil-works/pi-ai" ] &&
		[ -d "$nm/@earendil-works/pi-tui" ] &&
		[ -d "$nm/typebox" ]
}

snapshot_complete() { # <dir> <sha> — a complete snapshot of <sha>, not just a same-named dir
	local dir="$1" sha="$2"
	[ -d "$dir" ] && \
		[ -f "$dir/$SNAPSHOT_EXT_MARKER" ] && \
		[ -d "$dir/node_modules" ] && \
		snapshot_has_packages "$dir/node_modules" && \
		snapshot_manifest_valid "$dir/manifest.json" "$sha"
}

snapshot_current_target() { # <releases> — resolved target of current, empty when absent
	# current is always created here as a relative symlink to a sha, so plain
	# readlink joined with the link's directory resolves it on every platform
	# (BSD readlink has no -f, and $1 is already a physical path).
	local cur="$1/current" target
	[ -L "$cur" ] || return 0
	target="$(readlink "$cur" 2>/dev/null || true)"
	[ -n "$target" ] || return 0
	case "$target" in
	/*) printf '%s\n' "$target" ;;
	*) printf '%s\n' "$1/$target" ;;
	esac
}

snapshot_flip() { # <releases> <sha> — atomic relative-symlink replacement
	local releases="$1" sha="$2" cur="$1/current" link="$1/.current.tmp-$$"
	snapshot_lock_verify "the current flip"
	if [ -e "$cur" ] && [ ! -L "$cur" ]; then
		die "snapshot: $cur exists and is not a symlink; refusing to replace it"
	fi
	rm -f -- "$link" 2>/dev/null || true
	ln -s -- "$sha" "$link" || die "snapshot: could not create symlink $link"
	if ! snapshot_rename_link "$link" "$cur"; then
		rm -f -- "$link" 2>/dev/null || true
		die "snapshot: could not atomically replace $cur"
	fi
}

snapshot_is_sha_name() { # <name> — true when the name is a full 40-char hex sha
	# A top-level helper by design: bash 3.2 (macOS system shell) cannot parse
	# a `case` statement nested inside process substitution < <( ... ), so the
	# prune loop must call this helper instead of inlining the pattern match.
	case "$1" in *[!0-9a-f]*) return 1 ;; esac
	return 0
}

snapshot_prune() { # <releases> <keep-sha> — current's target plus the newest 5
	# Prune is deliberately non-fatal: it returns 0 even when a directory
	# cannot be removed and reports at most ONE bounded warning line naming
	# the first such directory. Neither the passed sha nor the directory
	# current actually resolves to is ever a candidate.
	local releases="$1" keep="$2" dir path base kept=0 current_target failed=""
	local protected=""
	local -a stale=()
	snapshot_lock_verify "the retention prune"
	# Probe the stat dialect once here, in the parent shell: each element of the
	# process substitution below runs in its own subshell and would probe again.
	snapshot_stat_style
	current_target="$(snapshot_current_target "$releases")"
	while IFS=$'\t' read -r _ path; do
		kept=$((kept + 1))
		if [ "$kept" -le "$SNAPSHOT_KEEP" ]; then
			continue
		fi
		stale+=("$path")
	done < <(
		for dir in "$releases"/*/; do
			[ -d "$dir" ] || continue
			path="${dir%/}"
			base="${path##*/}"
			if [ "$base" = "$keep" ] || [ "$path" = "$current_target" ]; then
				continue
			fi
			[ "${#base}" -eq 40 ] || continue
			snapshot_is_sha_name "$base" || continue
			printf '%s\t%s\n' "$(snapshot_mtime "$path")" "$path"
		done | sort -rn -k1,1
	)
	# Ownership and the current target are re-checked per directory, not once
	# for the whole loop: a holder that is paused after the section-level check
	# can lose the lock to an age-based takeover, and the resumed holder would
	# then keep deleting the list it selected while another process is already
	# the owner and may have repointed current at one of those directories. The
	# order is deliberate: the recursive write-permission walk runs first and the
	# removal itself is one rm (no second walk inside it), so the window between
	# the last check and the rm syscall is a fork and an exec. That residual
	# window cannot be closed without a kernel primitive that re-checks and
	# unlinks in one step; it is documented in the README.
	for path in ${stale[@]+"${stale[@]}"}; do
		snapshot_make_writable "$path"
		snapshot_lock_verify "the retention prune of ${path##*/}"
		current_target="$(snapshot_current_target "$releases")"
		if [ "$path" = "$current_target" ] || [ "$path" = "$releases/$keep" ]; then
			[ -n "$protected" ] || protected="$path"
			continue
		fi
		if snapshot_remove_tree_now "$path"; then
			continue
		fi
		[ -n "$failed" ] || failed="$path"
	done
	# The last check comes after the loop as well: a holder that lost the lock
	# anywhere in it must never report a clean prune, which is what the old
	# single section-level check did before it went on to delete the rest of the
	# list. Warnings below are only for a prune that still owns the directory.
	snapshot_lock_verify "the end of the retention prune"
	if [ -n "$protected" ]; then
		warn "snapshot: kept $(snapshot_bounded "$protected" 120) because it is current or the snapshot another process is publishing now"
	fi
	if [ -n "$failed" ]; then
		warn "snapshot: could not remove the old snapshot $(snapshot_bounded "$failed" 120); it stays on disk"
	fi
	return 0
}

snapshot_materialize() { # <repo> <releases> <sha> <dirty>
	local repo="$1" releases="$2" sha="$3" dirty="$4"
	local final="$releases/$sha" tmp="$releases/.tmp-$sha-$$"
	local nm_src="" prev created_at

	[ -f "$repo/$SNAPSHOT_EXT_MARKER" ] || \
		die "snapshot: $repo/$SNAPSHOT_EXT_MARKER is missing; $repo/extensions is not an agent-kit extension set"
	SNAPSHOT_RELEASES="$releases"
	SNAPSHOT_TMP="$tmp"
	snapshot_remove_tree "$tmp" || true
	mkdir -- "$tmp" || die "snapshot: could not create $tmp"

	mkdir -- "$tmp/extensions" || die "snapshot: could not create $tmp/extensions"
	snapshot_cp_archive "$repo/extensions/." "$tmp/extensions/" || \
		die "snapshot: could not copy extensions from $repo/extensions"

	# Prefer the runtime packages already materialized by the previous snapshot;
	# on the first sync the checkout's own node_modules is the source. Symlinks
	# are dereferenced so the new snapshot never depends on an older one.
	if [ -L "$releases/current" ]; then
		prev="$(readlink "$releases/current")"
		case "$prev" in
		/*) : ;;
		*) prev="$releases/$prev" ;;
		esac
		if [ -d "$prev/node_modules" ] && snapshot_has_packages "$prev/node_modules"; then
			nm_src="$prev/node_modules"
		fi
	fi
	if [ -z "$nm_src" ] && [ -d "$repo/node_modules" ] && snapshot_has_packages "$repo/node_modules"; then
		nm_src="$repo/node_modules"
	fi
	[ -n "$nm_src" ] || die "snapshot: no node_modules source provides @earendil-works/pi-coding-agent, pi-ai, pi-tui and typebox (looked at $releases/current and $repo/node_modules)"
	if ! snapshot_hardlink_tree "$nm_src" "$tmp/node_modules"; then
		snapshot_remove_tree "$tmp/node_modules" || true
		snapshot_cp_deref "$nm_src" "$tmp/node_modules" || \
			die "snapshot: could not copy node_modules from $nm_src"
	fi

	created_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
	{
		printf '{\n'
		printf '  "schema": 1,\n'
		printf '  "sha": "%s",\n' "$sha"
		printf '  "dirty": %s,\n' "$dirty"
		printf '  "createdAt": "%s",\n' "$created_at"
		printf '  "source": "'
		snapshot_json_escape "$repo"
		printf '"\n'
		printf '}\n'
	} > "$tmp/manifest.json" || die "snapshot: could not write $tmp/manifest.json"

	# BSD mv has no -T and plain mv nests into an existing directory, so the
	# publish rename asks for the non-replacing rename(2) semantics first and
	# only falls back to a nesting-detecting plain mv. A directory that appeared
	# meanwhile is a conflict, never a silent nest into a published snapshot.
	if [ -e "$final" ] || [ -L "$final" ]; then
		die "snapshot: $final appeared while building $tmp; move it out of the way and retry"
	fi
	snapshot_lock_verify "the publish rename"
	if ! snapshot_rename_dir "$tmp" "$final"; then
		# The last-resort rename nests the build inside $final when the target
		# appears under it. That nested tree is OUR OWN build, never a part of
		# the published snapshot, so it is destroyed in place when the undo move
		# failed; leaving it would mutate an immutable artifact.
		if [ -n "$SNAPSHOT_NESTED" ]; then
			if snapshot_remove_tree "$SNAPSHOT_NESTED"; then
				die "snapshot: $final appeared while building $tmp; move it out of the way and retry (the nested build $SNAPSHOT_NESTED was destroyed in place)"
			fi
			# Removal failed too: report the tree that really exists and point
			# the EXIT cleanup at it, which now also reaches a .tmp-* one level
			# inside a published snapshot.
			SNAPSHOT_TMP="$SNAPSHOT_NESTED"
			die "snapshot: $final appeared while building $tmp and the nested build could not be undone or removed; $SNAPSHOT_NESTED still exists inside the published snapshot $final and must be removed manually"
		fi
		die "snapshot: $final appeared while building $tmp; move it out of the way and retry"
	fi
	SNAPSHOT_TMP=""
	snapshot_complete "$final" "$sha" || \
		die "snapshot: $final is not a complete snapshot of $sha after materialization; remove it manually"
}

cmd_snapshot() { # <releases-dir>
	[ $# -eq 1 ] && [ -n "$1" ] || die "snapshot takes exactly one argument: <releases-dir> (see: agent-kit help)"
	local arg="$1" releases sha branch status dirty=false final

	git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1 || \
		die "snapshot: $REPO is not a git checkout; there is no HEAD to snapshot"
	branch="$(git -C "$REPO" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
	if [ -z "$branch" ] || [ "$branch" = "HEAD" ]; then
		die "snapshot: $REPO is in detached HEAD state; switch to a branch first"
	fi
	sha="$(git -C "$REPO" rev-parse --verify HEAD 2>/dev/null || true)"
	case "$sha" in
	""|*[!0-9a-f]*) die "snapshot: could not resolve a full HEAD sha in $REPO" ;;
	esac
	[ "${#sha}" -eq 40 ] || die "snapshot: HEAD sha is not a full 40-character sha: $sha"
	status="$(git -C "$REPO" status --porcelain --untracked-files=normal 2>/dev/null)" || \
		die "snapshot: could not read the working tree state of $REPO"
	[ -n "$status" ] && dirty=true

	[ -d "$arg" ] || mkdir -p -- "$arg" 2>/dev/null || die "snapshot: cannot create releases dir $arg"
	releases="$(cd -- "$arg" && pwd -P)" || die "snapshot: cannot resolve releases dir $arg"
	final="$releases/$sha"

	# The cleanup trap is installed before the lock is taken: a death inside
	# lock acquisition (a takeover whose restore loses the freed name) must
	# still release the takeover claim and any temporary state.
	trap snapshot_cleanup EXIT
	snapshot_lock "$releases"

	if [ -e "$final" ] || [ -L "$final" ]; then
		if snapshot_complete "$final" "$sha"; then
			if [ "$(snapshot_current_target "$releases")" != "$final" ]; then
				snapshot_flip "$releases" "$sha"
			fi
			snapshot_prune "$releases" "$sha"
			msg "Snapshot $sha is already present ($final); current points at it"
			return 0
		fi
		die "snapshot: $final exists but is not a complete snapshot of $sha; remove it manually"
	fi

	snapshot_materialize "$REPO" "$releases" "$sha" "$dirty"
	snapshot_flip "$releases" "$sha"
	# The flip comes first on purpose: retention must never leave current
	# pointing at what it is about to delete, and a prune failure is only a
	# warning.
	snapshot_prune "$releases" "$sha"
	msg "Snapshot $sha -> $final (current)"
}


cmd_snapshot "$@"
